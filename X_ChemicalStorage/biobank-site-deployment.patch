diff --git a/deploy/1-prepare-machine.ps1 b/deploy/1-prepare-machine.ps1
new file mode 100644
index 0000000..30d6ac1
--- /dev/null
+++ b/deploy/1-prepare-machine.ps1
@@ -0,0 +1,68 @@
+﻿<#
+  الخطوة 1 — تجهيز جهاز المعمل (تشغيل مرة واحدة، PowerShell كـ Administrator)
+  - يمنع النوم/الإسبات وإطفاء الهارد
+  - يمنع ويندوز يعمل Restart لوحده بعد التحديثات
+  - يظبط المنطقة الزمنية لمصر ومزامنة الساعة
+  - يعمل فولدرات البرنامج والـ Backup
+  - يتأكد إن SQL Server Express و Mosquitto متنصبين
+#>
+param(
+    [string]$AppDir = 'C:\XChemicalStorage',
+    [string]$BackupDir = 'D:\BioBank_Backups'
+)
+$ErrorActionPreference = 'Stop'
+function Ok($m)   { Write-Host "  [OK]   $m" -ForegroundColor Green }
+function Warn($m) { Write-Host "  [!!]   $m" -ForegroundColor Yellow; $script:warnings++ }
+$warnings = 0
+
+if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
+    throw 'شغّلي PowerShell كـ Administrator (Run as administrator).'
+}
+
+Write-Host "`n== الطاقة ==" -ForegroundColor Cyan
+powercfg /change standby-timeout-ac 0 | Out-Null
+powercfg /change hibernate-timeout-ac 0 | Out-Null
+powercfg /change disk-timeout-ac 0 | Out-Null
+powercfg /hibernate off | Out-Null
+Ok 'النوم والإسبات وإطفاء الهارد اتقفلوا (الشاشة ممكن تطفي عادي)'
+
+Write-Host "`n== تحديثات ويندوز ==" -ForegroundColor Cyan
+$au = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU'
+New-Item -Path $au -Force | Out-Null
+Set-ItemProperty -Path $au -Name NoAutoRebootWithLoggedOnUsers -Value 1 -Type DWord
+Set-ItemProperty -Path $au -Name AUOptions -Value 3 -Type DWord      # تنزيل بس، والتنصيب يدوي
+Ok 'ويندوز مش هيعمل Restart لوحده. خلي التحديثات يدوي في ميعاد صيانة متفق عليه'
+
+Write-Host "`n== الوقت ==" -ForegroundColor Cyan
+Set-TimeZone -Id 'Egypt Standard Time'
+try {
+    Set-Service w32time -StartupType Automatic; Start-Service w32time -ErrorAction SilentlyContinue
+    w32tm /resync /force 2>$null | Out-Null
+    Ok "المنطقة الزمنية مصر — الساعة دلوقتي $(Get-Date -Format 'yyyy-MM-dd HH:mm')"
+} catch { Warn 'مزامنة الساعة فشلت (مفيش نت؟). اتأكدي من الساعة يدوي' }
+
+Write-Host "`n== الفولدرات ==" -ForegroundColor Cyan
+foreach ($d in @($AppDir, $BackupDir)) {
+    try { New-Item -ItemType Directory -Path $d -Force | Out-Null; Ok $d }
+    catch { Warn "معرفتش أعمل $d (الدرايف موجود؟). غيّري -BackupDir" }
+}
+# SQL Server بيكتب الـ .bak بنفسه، فلازم حسابه يقدر يكتب في فولدر الـ Backup
+try {
+    $acl = Get-Acl $BackupDir
+    $rule = New-Object Security.AccessControl.FileSystemAccessRule('NT SERVICE\MSSQL$SQLEXPRESS', 'Modify', 'ContainerInherit,ObjectInherit', 'None', 'Allow')
+    $acl.AddAccessRule($rule); Set-Acl $BackupDir $acl
+    Ok 'صلاحية SQL Express على فولدر الـ Backup'
+} catch { Warn 'معرفتش أدي SQL Express صلاحية على فولدر الـ Backup (هيتظبط بعد تنصيب SQL Express — شغلي السكريبت تاني)' }
+
+Write-Host "`n== البرامج المطلوبة ==" -ForegroundColor Cyan
+if (Get-Service 'MSSQL$SQLEXPRESS' -ErrorAction SilentlyContinue) {
+    Set-Service 'MSSQL$SQLEXPRESS' -StartupType Automatic; Ok 'SQL Server Express متنصب'
+} else { Warn 'SQL Server Express مش متنصب → https://www.microsoft.com/sql-server/sql-server-downloads (Express, Basic)' }
+
+if (Get-Service mosquitto -ErrorAction SilentlyContinue) {
+    Set-Service mosquitto -StartupType Automatic; Ok 'Mosquitto متنصب'
+} else { Warn 'Mosquitto مش متنصب → https://mosquitto.org/download (Windows 64-bit) — علّمي على Service' }
+
+Write-Host ''
+if ($warnings -eq 0) { Write-Host 'الجهاز جاهز. الخطوة الجاية: 2-configure-mosquitto.ps1' -ForegroundColor Green }
+else { Write-Host "فيه $warnings ملاحظة فوق. صلّحيها وشغّلي السكريبت تاني." -ForegroundColor Yellow }
diff --git a/deploy/2-configure-mosquitto.ps1 b/deploy/2-configure-mosquitto.ps1
new file mode 100644
index 0000000..587d5c2
--- /dev/null
+++ b/deploy/2-configure-mosquitto.ps1
@@ -0,0 +1,48 @@
+﻿<#
+  الخطوة 2 — ضبط Mosquitto (الـ MQTT broker اللي الفريزرات بتبعتله)
+  - بيقفل الدخول بدون باسورد
+  - بيعمل يوزر للأبلكيشن والبوابة
+  - بيفتح البورت 1883 على الشبكة المحلية بس (عشان البوابة تقدر توصل)
+
+  مثال:  .\2-configure-mosquitto.ps1 -User biobank -Password 'Strong#Pass1'
+  نفس اليوزر والباسورد يتحطوا في appsettings.Local.json (Mqtt) وفي إعدادات البوابة.
+#>
+param(
+    [Parameter(Mandatory)] [string]$User,
+    [Parameter(Mandatory)] [string]$Password,
+    [string]$MosquittoDir = 'C:\Program Files\mosquitto'
+)
+$ErrorActionPreference = 'Stop'
+if (-not (Test-Path "$MosquittoDir\mosquitto.exe")) { throw "Mosquitto مش موجود في $MosquittoDir" }
+
+$conf = Join-Path $MosquittoDir 'mosquitto.conf'
+$pwFile = Join-Path $MosquittoDir 'passwd'
+$logDir = 'C:\ProgramData\mosquitto'
+New-Item -ItemType Directory -Path $logDir -Force | Out-Null
+
+if (Test-Path $conf) { Copy-Item $conf "$conf.bak-$(Get-Date -Format yyyyMMddHHmm)" }
+@"
+# BioBank — generated by 2-configure-mosquitto.ps1
+listener 1883 0.0.0.0
+allow_anonymous false
+password_file $pwFile
+persistence true
+persistence_location $logDir\
+log_dest file $logDir\mosquitto.log
+log_type error
+log_type warning
+log_type notice
+"@ | Set-Content -Path $conf -Encoding ascii
+
+& "$MosquittoDir\mosquitto_passwd.exe" -c -b $pwFile $User $Password
+if ($LASTEXITCODE -ne 0) { throw 'فشل إنشاء ملف الباسورد' }
+
+if (-not (Get-NetFirewallRule -DisplayName 'BioBank MQTT 1883' -ErrorAction SilentlyContinue)) {
+    New-NetFirewallRule -DisplayName 'BioBank MQTT 1883' -Direction Inbound -Protocol TCP -LocalPort 1883 -Profile Private,Domain -Action Allow | Out-Null
+}
+
+Restart-Service mosquitto
+Start-Sleep 2
+& "$MosquittoDir\mosquitto_pub.exe" -h 127.0.0.1 -t 'biobank/selftest' -m ok -u $User -P $Password
+if ($LASTEXITCODE -eq 0) { Write-Host 'Mosquitto شغال والدخول بالباسورد تمام.' -ForegroundColor Green }
+else { Write-Host "Mosquitto مش بيرد. شوفي $logDir\mosquitto.log" -ForegroundColor Red }
diff --git a/deploy/3-install-service.ps1 b/deploy/3-install-service.ps1
new file mode 100644
index 0000000..9a58551
--- /dev/null
+++ b/deploy/3-install-service.ps1
@@ -0,0 +1,88 @@
+﻿<#
+  الخطوة 3 — تنصيب/تحديث البرنامج كـ Windows Service
+  - بيعمل publish (لو dotnet SDK موجود) أو ياخد فولدر publish جاهز
+  - بينسخ لـ C:\XChemicalStorage ويحافظ على appsettings.Local.json
+  - Service بيقوم مع الجهاز (Delayed) وبيعيد التشغيل لوحده لو وقع
+  - بيفتح البورت 5000 على الشبكة المحلية
+
+  تنصيب أول مرة أو تحديث:   .\3-install-service.ps1
+  من فولدر publish جاهز:     .\3-install-service.ps1 -PublishDir D:\publish
+#>
+param(
+    [string]$AppDir = 'C:\XChemicalStorage',
+    [string]$PublishDir = '',
+    [int]$Port = 5000
+)
+$ErrorActionPreference = 'Stop'
+$svc = 'XChemicalStorage'
+$root = Split-Path $PSScriptRoot -Parent
+$proj = Join-Path $root 'X_ChemicalStorage\X_ChemicalStorage.csproj'
+
+if (-not $PublishDir) {
+    if (-not (Get-Command dotnet -ErrorAction SilentlyContinue)) { throw 'dotnet SDK مش موجود. اعملي Publish من Visual Studio ومرّري -PublishDir' }
+    $PublishDir = Join-Path $PSScriptRoot 'out'
+    Write-Host 'Publishing (Release, win-x64, self-contained)...' -ForegroundColor Cyan
+    dotnet publish $proj -c Release -r win-x64 --self-contained true -o $PublishDir
+    if ($LASTEXITCODE -ne 0) { throw 'الـ publish فشل' }
+}
+if (-not (Test-Path (Join-Path $PublishDir 'X_ChemicalStorage.exe'))) { throw "X_ChemicalStorage.exe مش موجود في $PublishDir" }
+
+$existing = Get-Service $svc -ErrorAction SilentlyContinue
+if ($existing -and $existing.Status -ne 'Stopped') {
+    Write-Host 'إيقاف الخدمة الحالية...' -ForegroundColor Cyan
+    Stop-Service $svc -Force
+    (Get-Service $svc).WaitForStatus('Stopped', '00:00:30')
+}
+
+New-Item -ItemType Directory -Path $AppDir -Force | Out-Null
+# نحافظ على الإعدادات والملفات المرفوعة الخاصة بالموقع
+robocopy $PublishDir $AppDir /E /NFL /NDL /NJH /NJS /XF appsettings.Local.json /XD App_Data | Out-Null
+if ($LASTEXITCODE -ge 8) { throw "النسخ فشل (robocopy code $LASTEXITCODE)" }
+New-Item -ItemType Directory -Path (Join-Path $AppDir 'App_Data') -Force | Out-Null
+
+$local = Join-Path $AppDir 'appsettings.Local.json'
+if (-not (Test-Path $local)) {
+    Copy-Item (Join-Path $AppDir 'appsettings.Local.example.json') $local
+    Write-Host "`nاتعمل $local من النموذج. املي القيم (باسورد الأدمن، Telegram، MQTT) وبعدين شغّلي السكريبت تاني." -ForegroundColor Yellow
+    notepad $local
+    return
+}
+
+$exe = Join-Path $AppDir 'X_ChemicalStorage.exe'
+if (-not $existing) {
+    $deps = @('mosquitto')
+    if (Get-Service 'MSSQL$SQLEXPRESS' -ErrorAction SilentlyContinue) { $deps += 'MSSQL$SQLEXPRESS' }
+    New-Service -Name $svc -BinaryPathName "`"$exe`"" -DisplayName 'X Chemical Storage - BioBank' `
+        -Description 'Chemical storage and Bio Bank freezer monitoring' -StartupType Automatic -DependsOn $deps | Out-Null
+    sc.exe config $svc start= delayed-auto | Out-Null
+    # إعادة تشغيل بعد 10 ثواني / 30 ثانية / دقيقة لو وقع، والعداد يتصفر كل يوم
+    sc.exe failure $svc reset= 86400 actions= restart/10000/restart/30000/restart/60000 | Out-Null
+    sc.exe failureflag $svc 1 | Out-Null
+    Write-Host 'الخدمة اتنصبت.' -ForegroundColor Green
+}
+
+# الخدمة شغالة كـ LocalSystem: لازم يكون ليها دخول على SQL Express
+$sqlcmd = Get-Command sqlcmd -ErrorAction SilentlyContinue
+if ($sqlcmd) {
+    sqlcmd -S '.\SQLEXPRESS' -E -b -Q "IF NOT EXISTS (SELECT 1 FROM sys.server_principals WHERE name = N'NT AUTHORITY\SYSTEM') CREATE LOGIN [NT AUTHORITY\SYSTEM] FROM WINDOWS; IF IS_SRVROLEMEMBER('dbcreator', N'NT AUTHORITY\SYSTEM') = 0 ALTER SERVER ROLE dbcreator ADD MEMBER [NT AUTHORITY\SYSTEM];" | Out-Null
+    if ($LASTEXITCODE -eq 0) { Write-Host 'صلاحية الخدمة على SQL Express تمام.' -ForegroundColor Green }
+    else { Write-Host 'معرفتش أظبط صلاحية SQL. شوفي DEPLOYMENT.md (مشاكل شائعة).' -ForegroundColor Yellow }
+} else { Write-Host 'sqlcmd مش موجود: اتأكدي إن NT AUTHORITY\SYSTEM ليه dbcreator على SQL Express (DEPLOYMENT.md).' -ForegroundColor Yellow }
+
+if (-not (Get-NetFirewallRule -DisplayName "BioBank Web $Port" -ErrorAction SilentlyContinue)) {
+    New-NetFirewallRule -DisplayName "BioBank Web $Port" -Direction Inbound -Protocol TCP -LocalPort $Port -Profile Private,Domain -Action Allow | Out-Null
+}
+
+Start-Service $svc
+Write-Host 'مستني البرنامج يقوم (أول مرة بيعمل الداتابيز)...' -ForegroundColor Cyan
+$ok = $false
+foreach ($i in 1..30) {
+    Start-Sleep 3
+    try { $r = Invoke-RestMethod "http://localhost:$Port/healthz" -TimeoutSec 5; $ok = $true; break } catch { }
+}
+if ($ok) {
+    Write-Host "البرنامج شغال: http://localhost:$Port  (status = $($r.status))" -ForegroundColor Green
+    Write-Host 'الفحص الحقيقي بيبدأ بعد دقيقتين من التشغيل. شغّلي 4-check-health.ps1 بعد 3 دقايق.'
+} else {
+    Write-Host 'البرنامج مقامش. افتحي Event Viewer > Windows Logs > Application وشوفي أخطاء XChemicalStorage.' -ForegroundColor Red
+}
diff --git a/deploy/4-check-health.ps1 b/deploy/4-check-health.ps1
new file mode 100644
index 0000000..dd9f1d5
--- /dev/null
+++ b/deploy/4-check-health.ps1
@@ -0,0 +1,35 @@
+﻿<#
+  الخطوة 4 — فحص شامل للنظام (شغّليه بعد التنصيب، وقبل ما تمشي من الموقع)
+#>
+param([int]$Port = 5000, [string]$BackupDir = 'D:\BioBank_Backups')
+$fail = 0
+function Check($name, [scriptblock]$test) {
+    try { $r = & $test; if ($r) { Write-Host "  [OK]   $name" -ForegroundColor Green } else { throw 'x' } }
+    catch { Write-Host "  [XX]   $name" -ForegroundColor Red; $script:fail++ }
+}
+
+Write-Host "`n== الخدمات ==" -ForegroundColor Cyan
+Check 'SQL Server Express شغال'   { (Get-Service 'MSSQL$SQLEXPRESS').Status -eq 'Running' }
+Check 'Mosquitto شغال'            { (Get-Service mosquitto).Status -eq 'Running' }
+Check 'XChemicalStorage شغال'      { (Get-Service XChemicalStorage).Status -eq 'Running' }
+Check 'الخدمة بتقوم مع الجهاز'     { (Get-CimInstance Win32_Service -Filter "Name='XChemicalStorage'").StartMode -eq 'Auto' }
+
+Write-Host "`n== البرنامج ==" -ForegroundColor Cyan
+$h = $null
+try { $h = Invoke-RestMethod "http://localhost:$Port/healthz" -TimeoutSec 5 } catch { }
+Check "الموقع بيرد على البورت $Port" { $null -ne $h }
+Check 'حالة النظام ok (MQTT + الإنذارات + الإشعارات)' { $h.status -eq 'ok' }
+if ($h -and $h.status -ne 'ok') { Write-Host "         الحالة: $($h.status) — التفاصيل من الأبلكيشن: IoT Health" -ForegroundColor Yellow }
+
+Write-Host "`n== الجهاز ==" -ForegroundColor Cyan
+Check 'النوم مقفول'                { "$((powercfg /query SCHEME_CURRENT SUB_SLEEP STANDBYIDLE) | Select-String 'Current AC Power Setting Index')" -match '0x00000000' }
+Check 'المنطقة الزمنية مصر'        { (Get-TimeZone).Id -eq 'Egypt Standard Time' }
+Check "فولدر الـ Backup موجود"      { Test-Path $BackupDir }
+$last = Get-ChildItem $BackupDir -Filter *.bak -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1
+Check 'فيه Backup اتعمل'           { $null -ne $last }
+if ($last) { Write-Host "         آخر Backup: $($last.Name)  ($([math]::Round($last.Length/1MB,1)) MB, $($last.LastWriteTime))" }
+$ups = Get-CimInstance Win32_Battery -ErrorAction SilentlyContinue
+if ($ups) { Write-Host '  [OK]   UPS متوصل بالـ USB' -ForegroundColor Green } else { Write-Host '  [--]   UPS مش متوصل بالـ USB (لو موجود ومتوصل كهربا بس، تمام)' -ForegroundColor Yellow }
+
+Write-Host ''
+if ($fail -eq 0) { Write-Host 'كله تمام.' -ForegroundColor Green } else { Write-Host "$fail فحص فشل. شوفي DEPLOYMENT.md (مشاكل شائعة)." -ForegroundColor Red }
diff --git a/deploy/simulate-freezers.ps1 b/deploy/simulate-freezers.ps1
new file mode 100644
index 0000000..edd3ab0
--- /dev/null
+++ b/deploy/simulate-freezers.ps1
@@ -0,0 +1,83 @@
+﻿<#
+  محاكي فريزرات — بيبعت قراءات MQTT بنفس شكل البوابة الحقيقية، عشان تختبري الدورة كاملة
+  (استقبال → حفظ → إنذار → إشعار → كشف الانقطاع) من غير فريزر حقيقي.
+
+  أمثلة:
+    .\simulate-freezers.ps1                                  # 3 فريزرات طبيعي كل 10 ثواني
+    .\simulate-freezers.ps1 -Scenario HighTemp -Freezer SIM-80A
+    .\simulate-freezers.ps1 -Scenario DoorOpen
+    .\simulate-freezers.ps1 -Scenario PowerFail
+    .\simulate-freezers.ps1 -Scenario Offline                # يبعت شوية وبعدين يسكت (اختبار الانقطاع)
+    .\simulate-freezers.ps1 -User biobank -Password xxx      # لو الـ broker عليه باسورد
+
+  شكل الرسالة:  topic = freezer/<CODE>/telemetry
+  { "temperature": -79.8, "set_temp": -80, "ambient_temp": 24.5, "door": "closed", "power": "ok", "online": true }
+#>
+param(
+    [ValidateSet('Normal', 'HighTemp', 'DoorOpen', 'PowerFail', 'Offline')]
+    [string]$Scenario = 'Normal',
+    [string]$Freezer = '',
+    [string]$BrokerHost = '127.0.0.1',
+    [int]$Port = 1883,
+    [string]$User = '',
+    [string]$Password = '',
+    [int]$IntervalSeconds = 10,
+    [int]$Count = 0   # 0 = لحد ما توقفيه بـ Ctrl+C
+)
+
+$ErrorActionPreference = 'Stop'
+
+$pub = (Get-Command mosquitto_pub -ErrorAction SilentlyContinue).Source
+if (-not $pub) { $pub = 'C:\Program Files\mosquitto\mosquitto_pub.exe' }
+if (-not (Test-Path $pub)) { throw "mosquitto_pub مش موجود. نصّبي Mosquitto الأول (install-prerequisites.ps1)." }
+
+# أكواد الفريزرات الوهمية ودرجة الضبط بتاعة كل واحد
+$freezers = [ordered]@{ 'SIM-80A' = -80; 'SIM-20A' = -20; 'SIM-04A' = 4 }
+if ($Freezer) {
+    if (-not $freezers.Contains($Freezer)) { $freezers = [ordered]@{ $Freezer = -80 } }
+    else { $freezers = [ordered]@{ $Freezer = $freezers[$Freezer] } }
+}
+
+$rand = [System.Random]::new()
+$tmp = Join-Path $env:TEMP 'biobank-sim-payload.json'
+$sent = 0
+Write-Host "Scenario=$Scenario  Broker=${BrokerHost}:$Port  Freezers=$($freezers.Keys -join ', ')" -ForegroundColor Cyan
+
+while ($true) {
+    foreach ($code in $freezers.Keys) {
+        $set = [double]$freezers[$code]
+        $temp = $set + ($rand.NextDouble() - 0.5)          # تذبذب طبيعي ±0.5
+        $door = 'closed'; $power = 'ok'
+
+        switch ($Scenario) {
+            'HighTemp'  { $temp = $set + 5 + ($sent * 1.5) }   # بتطلع تدريجياً لحد ما تعدّي الحد
+            'DoorOpen'  { $door = 'open' }
+            'PowerFail' { $power = 'fail'; $temp = $set + ($sent * 0.8) }
+        }
+
+        $payload = [ordered]@{
+            temperature  = [math]::Round($temp, 1)
+            set_temp     = $set
+            ambient_temp = [math]::Round(24 + $rand.NextDouble(), 1)
+            door         = $door
+            power        = $power
+            online       = $true
+        } | ConvertTo-Json -Compress
+
+        # الـ JSON بيتبعت من ملف: PowerShell 5.1 بيبوّظ علامات " لو اتبعتت كـ argument
+        [System.IO.File]::WriteAllText($tmp, $payload, [System.Text.UTF8Encoding]::new($false))
+        $pubArgs = @('-h', $BrokerHost, '-p', $Port, '-t', "freezer/$code/telemetry", '-f', $tmp, '-q', '1')
+        if ($User) { $pubArgs += @('-u', $User, '-P', $Password) }
+        & $pub @pubArgs
+        if ($LASTEXITCODE -ne 0) { Write-Warning "فشل الإرسال لـ $code (الـ broker شغال؟ اليوزر والباسورد صح؟)" }
+        else { Write-Host ("{0:HH:mm:ss}  {1,-8} {2}" -f (Get-Date), $code, $payload) }
+    }
+
+    $sent++
+    if ($Scenario -eq 'Offline' -and $sent -ge 3) {
+        Write-Host "`nOffline: وقفت الإرسال. المفروض إنذار انقطاع الاتصال يظهر خلال المهلة المضبوطة للفريزر." -ForegroundColor Yellow
+        break
+    }
+    if ($Count -gt 0 -and $sent -ge $Count) { break }
+    Start-Sleep -Seconds $IntervalSeconds
+}
