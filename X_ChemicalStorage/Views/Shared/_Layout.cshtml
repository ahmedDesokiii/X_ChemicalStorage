@using Microsoft.AspNetCore.Identity
@using X_ChemicalStorage.Constants
@using X_ChemicalStorage.Models
@inject IAuthorizationService AuthorizationService
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<ApplicationRole> RoleManager
@inject X_ChemicalStorage.Data.ApplicationDbContext LayoutDb
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    // Temporary samples needing attention (awaiting placement or overdue) → nav badge
    int tsAttention = 0;
    if (SignInManager.IsSignedIn(User))
    {
        try
        {
            var today = DateTime.Today;
            tsAttention = LayoutDb.TempSamples.Count(s =>
                s.Status == X_ChemicalStorage.Models.TempSamples.TempSampleStatus.Received ||
                ((s.Status == X_ChemicalStorage.Models.TempSamples.TempSampleStatus.Stored ||
                  s.Status == X_ChemicalStorage.Models.TempSamples.TempSampleStatus.CheckedOut) &&
                 s.PlannedWithdrawalDate != null && s.PlannedWithdrawalDate < today));
        }
        catch { /* table not migrated yet — never break the layout */ }
    }

    var servicesControllers = new[] { "Suppliers", "Categories", "Units", "ManufacuterCompanies", "Locations" };
    var isServicesActive = servicesControllers.Contains(currentController);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
