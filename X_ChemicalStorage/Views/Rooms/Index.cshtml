@using X_ChemicalStorage.Models.TempSamples
@model X_ChemicalStorage.Models.ViewModels.RoomsViewModel
@{
    ViewData["Title"] = "Storage Locations";

    int Used(int boxId) =>
        (Model.LotBoxOccupancy != null && Model.LotBoxOccupancy.TryGetValue(boxId, out var l) ? l : 0)
      + (Model.HoldingBoxOccupancy != null && Model.HoldingBoxOccupancy.TryGetValue(boxId, out var h) ? h : 0);
    int Samples(int boxId) => Model.HoldingBoxOccupancy != null && Model.HoldingBoxOccupancy.TryGetValue(boxId, out var h) ? h : 0;

    IEnumerable<Box> BoxesOf(StorageUnit u) => u.Shelves?.SelectMany(s => s.Boxes ?? new List<Box>()) ?? Enumerable.Empty<Box>();
    int SlotsOf(IEnumerable<Box> b) => b.Sum(x => x.RowsCount * x.ColumnsCount);
    int UsedOf(IEnumerable<Box> b) => b.Sum(x => Used(x.Id));

    var rooms = Model.RoomsList ?? new List<Room>();
    var allUnits = rooms.SelectMany(r => r.StorageUnits ?? new List<StorageUnit>()).ToList();
    var allBoxes = allUnits.SelectMany(BoxesOf).ToList();
    var totalSlots = SlotsOf(allBoxes);
    var totalUsed = UsedOf(allBoxes);
    var utilPct = totalSlots == 0 ? 0 : (int)Math.Round(totalUsed * 100.0 / totalSlots);
    var samplesTotal = Model.HoldingBoxOccupancy?.Values.Sum() ?? 0;
    int ri = 0;

    async Task RenderUnit(StorageUnit unit, Room room, bool holding)
    {
        var boxes = BoxesOf(unit).ToList();
        var slots = SlotsOf(boxes);
        var used = UsedOf(boxes);
        var pct = slots == 0 ? 0 : (int)Math.Round(used * 100.0 / slots);
        var cold = unit.StorageUnitType?.TemperatureValue < 0;
        int j = 0;

        <div class="rm-unit" data-search="@(unit.Name + " " + unit.StorageUnitType?.Name + " " + string.Join(" ", unit.Shelves?.Select(s => s.Name) ?? Array.Empty<string>()) + " " + string.Join(" ", boxes.Select(b => b.Name)))">
            <div class="rm-unit-bar" onclick="RM.toggle(this)">
                <i class="bi bi-chevron-right rm-chev"></i>
                <span class="rm-type @(holding ? "" : (cold ? "cold" : "room"))">
                    <i class="bi @(holding ? "bi-hourglass-split" : "bi-thermometer-half")"></i>@unit.StorageUnitType?.Name
                </span>
                <span class="rm-unit-name">@unit.Name @if (unit.IsHazardous) { <span class="haz"><i class="bi bi-radioactive"></i>HAZ</span> }</span>
                <span class="rm-meter @(pct >= 85 ? "hot" : "")" title="@used of @slots slots used">
                    @used/@slots
                    <span class="bar"><span style="--w:@(pct)%"></span></span>
                </span>
                <span class="rm-acts" onclick="event.stopPropagation()">
                    <button type="button" class="iv-icon-btn" data-tip="Edit unit"
                            data-id="@unit.Id" data-name="@unit.Name" data-type="@unit.StorageUnitTypeId"
                            data-haz="@unit.IsHazardous.ToString().ToLower()" data-zone="@unit.Zone" onclick="RM.editUnit(this)">
                        <i class="bi bi-pencil-fill"></i>
                    </button>
                    <form asp-action="DeleteStorageUnit" method="post" class="rm-confirm" data-msg="Delete unit “@unit.Name” with all its shelves and boxes?">
                        <input type="hidden" name="id" value="@unit.Id" />
                        <button type="submit" class="iv-icon-btn danger" data-tip="Delete unit"><i class="bi bi-trash3-fill"></i></button>
                    </form>
                </span>
            </div>

            <div class="rm-expand">
                <div class="rm-expand-inner">
                    <div class="rm-shelves">
                        @if (unit.Shelves == null || !unit.Shelves.Any())
                        {
                            <div class="rm-empty mt-2">No shelves yet</div>
                        }
                        else
                        {
                            foreach (var shelf in unit.Shelves)
                            {
                                <div class="rm-shelf">
                                    <div class="rm-shelf-top">
                                        <i class="bi bi-layers"></i>
                                        <b>@shelf.Name</b>
                                        <span class="iv-sub">@(shelf.Boxes?.Count ?? 0) boxes</span>
                                        <button type="button" class="iv-icon-btn" style="width:28px;height:28px" data-tip="Add box" onclick="RM.inline('ab_@shelf.Id')"><i class="bi bi-plus-lg"></i></button>
                                        <button type="button" class="iv-icon-btn" style="width:28px;height:28px" data-tip="Rename shelf" data-id="@shelf.Id" data-name="@shelf.Name" onclick="RM.editShelf(this)"><i class="bi bi-pencil-fill"></i></button>
                                        <form asp-action="DeleteShelf" method="post" class="rm-confirm" data-msg="Delete shelf “@shelf.Name” and its boxes?">
                                            <input type="hidden" name="id" value="@shelf.Id" />
                                            <button type="submit" class="iv-icon-btn danger" style="width:28px;height:28px" data-tip="Delete shelf"><i class="bi bi-trash3-fill"></i></button>
                                        </form>
                                    </div>

                                    <div class="rm-boxes">
                                        @foreach (var box in shelf.Boxes ?? new List<Box>())
                                        {
                                            var bs = box.RowsCount * box.ColumnsCount;
                                            var bu = Used(box.Id);
                                            var bp = bs == 0 ? 0 : (int)Math.Round(bu * 100.0 / bs);
                                            <button type="button" class="rm-box @(bp >= 100 ? "full" : bp >= 60 ? "warm" : "")" style="--h:@bp;--j:@(j++)"
                                                    data-id="@box.Id" data-name="@box.Name" data-rows="@box.RowsCount" data-cols="@box.ColumnsCount"
                                                    data-path="@room.Name › @unit.Name › @shelf.Name › @box.Name"
                                                    onclick="RM.inspect(this)" title="@box.Name · @bu/@bs used">
                                                @if (Samples(box.Id) > 0) { <span class="smp"></span> }
                                                <b>@box.Name</b>
                                                <small>@bu/@bs · @(box.RowsCount)×@(box.ColumnsCount)</small>
                                            </button>
                                        }
                                        <button type="button" class="rm-box add" style="--j:@j" onclick="RM.inline('ab_@shelf.Id')" title="Add box"><i class="bi bi-plus-lg"></i></button>
                                    </div>

                                    <form asp-action="AddBox" method="post" class="rm-inline" id="ab_@shelf.Id">
                                        <input type="hidden" name="shelfId" value="@shelf.Id" />
                                        <input name="name" class="form-control" style="flex:1;min-width:110px" placeholder="Box name" required value="Box @((shelf.Boxes?.Count ?? 0) + 1)" />
                                        <input name="rowsCount" type="number" min="1" value="9" class="form-control num" title="Rows" required />
                                        <span class="align-self-center text-muted">×</span>
                                        <input name="columnsCount" type="number" min="1" value="9" class="form-control num" title="Columns" required />
                                        <button class="iv-btn iv-btn-primary" style="padding:6px 12px"><i class="bi bi-plus-lg"></i></button>
                                    </form>
                                </div>
                            }
                        }

                        <form asp-action="AddShelf" method="post" class="rm-inline show mt-2" style="background:transparent;border-style:dashed">
                            <input type="hidden" name="storageUnitId" value="@unit.Id" />
                            <input name="name" class="form-control" style="flex:1" placeholder="New shelf name…" required value="Shelf @((unit.Shelves?.Count ?? 0) + 1)" />
                            <button class="iv-btn iv-btn-ghost" style="padding:6px 12px"><i class="bi bi-plus-lg"></i> Shelf</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
<link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/rooms.css" asp-append-version="true" />

<!-- ═════════════════ HERO ═════════════════ -->
<div class="iv-hero" dir="ltr">
    <div class="iv-hero-orb"></div>
    <div class="container-fluid">
        <div class="iv-hero-row">
            <div class="iv-hero-id">
                <div class="iv-hero-icon"><i class="bi bi-building"></i></div>
                <div>
                    <h1 class="iv-hero-title">Storage Locations</h1>
                    <p class="iv-hero-sub">Rooms → units → shelves → boxes. Tiles fill with real occupancy — click any box to inspect it.</p>
                </div>
            </div>
            <div class="iv-hero-chips">
                <div class="iv-hero-chip"><b data-count="@rooms.Count">0</b><small>Rooms</small></div>
                <div class="iv-hero-chip" style="animation-delay:.05s"><b data-count="@allUnits.Count">0</b><small>Units</small></div>
                <div class="iv-hero-chip" style="animation-delay:.1s"><b data-count="@totalSlots">0</b><small>Slots</small></div>
                <div class="iv-hero-chip gold" style="animation-delay:.15s"><b><span data-count="@utilPct">0</span>%</b><small>Utilization</small></div>
                <div class="iv-hero-chip warn" style="animation-delay:.2s"><b data-count="@samplesTotal">0</b><small>Temp samples</small></div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid pb-4" dir="ltr">
    <!-- ═════════════════ TOOLBAR ═════════════════ -->
    <div class="rm-toolbar">
        <div class="rm-search">
            <i class="bi bi-search"></i>
            <input id="rmSearch" placeholder="Find a room, unit, shelf or box…  (press / )" autocomplete="off" />
        </div>
        <div class="rm-legend d-none d-lg-flex">
            <span><i style="background:rgba(63,154,174,.4)"></i>Used</span>
            <span><i style="background:rgba(197,165,71,.6)"></i>≥ 60%</span>
            <span><i style="background:rgba(214,69,80,.5)"></i>Full</span>
            <span><i style="background:#f4b740;border-radius:50%"></i>Has samples</span>
        </div>
        <button class="iv-btn iv-btn-ghost" onclick="RM.expandAll(true)" title="Expand all"><i class="bi bi-arrows-expand"></i></button>
        <button class="iv-btn iv-btn-ghost" onclick="RM.expandAll(false)" title="Collapse all"><i class="bi bi-arrows-collapse"></i></button>
        <a asp-controller="TempSamples" asp-action="Index" class="iv-btn" style="background:linear-gradient(135deg,#0f3d3e,#14595b);color:#fff">
            <i class="bi bi-hourglass-split"></i> Temporary Samples
            @if (samplesTotal > 0) { <span class="badge rounded-pill" style="background:#f4b740;color:#0f3d3e">@samplesTotal</span> }
        </a>
        <a asp-action="GenerateWizard" class="iv-btn iv-btn-ghost"><i class="bi bi-magic"></i> Auto-Generate</a>
        <button type="button" class="iv-btn iv-btn-gold" data-bs-toggle="modal" data-bs-target="#addRoomModal"><i class="bi bi-plus-lg"></i> Add Room</button>
    </div>

    <!-- ═════════════════ ROOMS ═════════════════ -->
    @if (!rooms.Any())
    {
        <div class="iv-panel"><div class="iv-empty">
            <i class="bi bi-building-add"></i>
            <h5>No rooms yet</h5>
            <p>Create a room manually, or let the wizard generate the whole hierarchy in one go.</p>
            <div class="d-flex gap-2 justify-content-center">
                <a asp-action="GenerateWizard" class="iv-btn iv-btn-primary"><i class="bi bi-magic"></i> Auto-Generate</a>
                <button class="iv-btn iv-btn-gold" data-bs-toggle="modal" data-bs-target="#addRoomModal"><i class="bi bi-plus-lg"></i> Add Room</button>
            </div>
        </div></div>
    }
    else
    {
        <div class="rm-grid" id="rmGrid">
            @foreach (var room in rooms)
            {
                var units = room.StorageUnits ?? new List<StorageUnit>();
                var lotUnits = units.Where(u => u.Zone == StorageZone.Inventory).ToList();
                var holdUnits = units.Where(u => u.Zone == StorageZone.TemporaryHolding).ToList();
                var rBoxes = units.SelectMany(BoxesOf).ToList();
                var rSlots = SlotsOf(rBoxes);
                var rUsed = UsedOf(rBoxes);
                var rPct = rSlots == 0 ? 0 : (int)Math.Round(rUsed * 100.0 / rSlots);
                var rSamples = rBoxes.Sum(b => Samples(b.Id));

                <div class="rm-card" style="--i:@(ri++)" data-room="@room.Name">
                    <div class="rm-head">
                        <div class="rm-head-row">
                            <div class="rm-head-ico"><i class="bi bi-door-open-fill"></i></div>
                            <div class="min-w-0">
                                <h3 class="rm-room-name">@room.Name</h3>
                                <small>@units.Count units · @rBoxes.Count boxes</small>
                            </div>
                            <div class="rm-ring" data-ring="@rPct" style="--c:@(rPct >= 85 ? "#ff8a92" : "#C5A547")" title="@rUsed of @rSlots slots used">
                                <b>@rPct%<small>USED</small></b>
                            </div>
                            <div class="dropdown">
                                <button class="rm-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-three-dots-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><button type="button" class="dropdown-item" onclick="RM.editRoom(@room.Id, this)" data-name="@room.Name"><i class="bi bi-pencil text-primary"></i>Rename room</button></li>
                                    <li><button type="button" class="dropdown-item" onclick="RM.expandRoom(this)"><i class="bi bi-arrows-expand"></i>Expand all units</button></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-action="DeleteRoom" method="post" class="rm-confirm" data-msg="Delete room “@room.Name”? Only possible when it holds no lots or samples.">
                                            <input type="hidden" name="id" value="@room.Id" />
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash"></i>Delete room</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="rm-body">
                        <!-- Lots inventory -->
                        <div class="rm-zone"><i class="bi bi-boxes"></i> Lots inventory <span class="cnt">@lotUnits.Count</span></div>
                        @if (!lotUnits.Any()) { <div class="rm-empty mb-2">No inventory units yet</div> }
                        @foreach (var u in lotUnits) { await RenderUnit(u, room, false); }

                        <!-- Temporary holding -->
                        <div class="rm-hold">
                            <div class="rm-zone">
                                <span class="pulse"></span> Temporary holding <span class="cnt">@holdUnits.Count</span>
                                @if (holdUnits.Any()) { <a class="cta" asp-controller="TempSamples" asp-action="Receive"><i class="bi bi-box-arrow-in-down"></i> Receive</a> }
                            </div>
                            @if (!holdUnits.Any())
                            {
                                <div class="rm-hold-empty">No holding unit here — add one below with zone <b>Temp Holding</b>.</div>
                            }
                            else
                            {
                                foreach (var u in holdUnits) { await RenderUnit(u, room, true); }
                                <a class="rm-hold-link" asp-controller="TempSamples" asp-action="Index"><i class="bi bi-journal-text"></i> @rSamples sample(s) · open custody register <i class="bi bi-arrow-right"></i></a>
                            }
                        </div>

                        <!-- Add unit -->
                        <div class="rm-add-unit">
                            <button type="button" class="rm-add-toggle" onclick="RM.inline('au_@room.Id')"><i class="bi bi-plus-circle"></i> Add storage unit</button>
                            <form asp-action="AddStorageUnit" method="post" class="rm-add-form" id="au_@room.Id">
                                <input type="hidden" name="roomId" value="@room.Id" />
                                <div class="row g-2">
                                    <div class="col-7"><input name="name" class="form-control" placeholder="Unit name" required value="Unit @(units.Count + 1)" /></div>
                                    <div class="col-5">
                                        <select name="storageUnitTypeId" class="form-select" required>
                                            @foreach (var t in Model.ListStorageUnitTypes) { <option value="@t.Value">@t.Text</option> }
                                        </select>
                                    </div>
                                </div>
                                <div class="rm-zone-pick">
                                    <input type="radio" name="zone" value="Inventory" id="zi_@room.Id" checked /><label for="zi_@room.Id" class="inv"><i class="bi bi-boxes"></i> Lots</label>
                                    <input type="radio" name="zone" value="TemporaryHolding" id="zh_@room.Id" /><label for="zh_@room.Id" class="hold"><i class="bi bi-hourglass-split"></i> Temp Holding</label>
                                </div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <label class="form-check-label small fw-bold text-danger"><input type="checkbox" name="isHazardous" value="true" class="form-check-input me-1" />Hazardous</label>
                                    <button class="iv-btn iv-btn-primary" style="padding:7px 14px"><i class="bi bi-plus-lg"></i> Add unit</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="rm-foot">
                        <div><b>@units.Count</b><small>Units</small></div>
                        <div><b>@units.Sum(u => u.Shelves?.Count ?? 0)</b><small>Shelves</small></div>
                        <div><b>@rBoxes.Count</b><small>Boxes</small></div>
                        <div class="gold"><b>@rUsed.ToString("N0")/@rSlots.ToString("N0")</b><small>Slots</small></div>
                        <div class="amber"><b>@rSamples</b><small>Samples</small></div>
                    </div>
                </div>
            }

            <div class="rm-new" style="--i:@ri" data-bs-toggle="modal" data-bs-target="#addRoomModal">
                <i class="bi bi-plus-lg"></i>
                <b>Add new room</b>
                <span class="iv-sub">or use Auto-Generate for a full structure</span>
            </div>
        </div>
    }
</div>

<!-- ═════════════════ MODALS ═════════════════ -->
<div class="modal fade iv-modal" id="addRoomModal" tabindex="-1" dir="ltr">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content iv-form" asp-action="SaveRoom" method="post">
            <div class="modal-header"><h5 class="modal-title"><i class="bi bi-door-open-fill"></i> <span id="roomModalTitle">Add room</span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" name="Id" id="roomId" value="0" />
                <div class="iv-field mb-0"><label>Room name</label><input name="Name" id="roomNameInput" class="form-control" required placeholder="e.g. Cold Room 1" /></div>
            </div>
            <div class="modal-footer"><button type="button" class="iv-btn iv-btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="iv-btn iv-btn-gold"><i class="bi bi-check2-circle"></i> Save room</button></div>
        </form>
    </div>
</div>

<div class="modal fade iv-modal" id="editUnitModal" tabindex="-1" dir="ltr">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content iv-form" asp-action="EditStorageUnit" method="post">
            <div class="modal-header"><h5 class="modal-title"><i class="bi bi-box-seam"></i> Edit storage unit</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" name="id" id="editUnitId" />
                <div class="iv-field"><label>Name</label><input name="name" id="editUnitName" class="form-control" required /></div>
                <div class="iv-field"><label>Type</label>
                    <select name="storageUnitTypeId" id="editUnitType" class="form-select" required>
                        @foreach (var t in Model.ListStorageUnitTypes) { <option value="@t.Value">@t.Text</option> }
                    </select>
                </div>
                <div class="iv-field"><label>Zone</label>
                    <div class="rm-zone-pick">
                        <input type="radio" name="zone" value="Inventory" id="ezInv" /><label for="ezInv" class="inv"><i class="bi bi-boxes"></i> Lots</label>
                        <input type="radio" name="zone" value="TemporaryHolding" id="ezHold" /><label for="ezHold" class="hold"><i class="bi bi-hourglass-split"></i> Temp Holding</label>
                    </div>
                    <small class="iv-sub"><i class="bi bi-info-circle"></i> Type and zone can only change while the unit is empty.</small>
                </div>
                <label class="form-check-label fw-bold text-danger"><input type="checkbox" name="isHazardous" value="true" id="editUnitHaz" class="form-check-input me-1" />Hazardous material</label>
            </div>
            <div class="modal-footer"><button type="button" class="iv-btn iv-btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="iv-btn iv-btn-gold"><i class="bi bi-check2-circle"></i> Save</button></div>
        </form>
    </div>
</div>

<div class="modal fade iv-modal" id="editShelfModal" tabindex="-1" dir="ltr">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <form class="modal-content iv-form" asp-action="EditShelf" method="post">
            <div class="modal-header"><h5 class="modal-title"><i class="bi bi-layers"></i> Rename shelf</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><input type="hidden" name="id" id="editShelfId" /><input name="name" id="editShelfName" class="form-control" required /></div>
            <div class="modal-footer"><button class="iv-btn iv-btn-gold w-100"><i class="bi bi-check2-circle"></i> Save</button></div>
        </form>
    </div>
</div>

<div class="modal fade iv-modal" id="editBoxModal" tabindex="-1" dir="ltr">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content iv-form" asp-action="EditBox" method="post">
            <div class="modal-header"><h5 class="modal-title"><i class="bi bi-grid-3x3"></i> Edit box</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" name="id" id="editBoxId" />
                <div class="iv-field"><label>Name</label><input name="name" id="editBoxName" class="form-control" required /></div>
                <div class="row g-2">
                    <div class="col-6 iv-field"><label>Rows</label><input name="rowsCount" id="editBoxRows" type="number" min="1" class="form-control" required /></div>
                    <div class="col-6 iv-field"><label>Columns</label><input name="columnsCount" id="editBoxCols" type="number" min="1" class="form-control" required /></div>
                </div>
                <small class="iv-sub"><i class="bi bi-info-circle"></i> Shrinking is blocked if anything would fall outside the new grid.</small>
            </div>
            <div class="modal-footer"><button type="button" class="iv-btn iv-btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="iv-btn iv-btn-gold"><i class="bi bi-check2-circle"></i> Save</button></div>
        </form>
    </div>
</div>

<!-- Box inspector -->
<div class="modal fade iv-modal" id="boxInspector" tabindex="-1" dir="ltr">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-grid-3x3-gap-fill"></i> <span id="biTitle">Box</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="iv-sub mb-3" id="biPath"></div>
                <div class="rm-insp-stats">
                    <div><b id="biSlots">–</b><small>Slots</small></div>
                    <div><b id="biLots">–</b><small>Lots</small></div>
                    <div><b id="biSamples">–</b><small>Samples</small></div>
                    <div><b id="biFree">–</b><small>Free</small></div>
                </div>
                <div class="text-center">
                    <div class="iv-grid-legend"><span><i class="lot"></i>Lot</span><span><i class="sample"></i>Temp sample</span><span><i class="free"></i>Free</span></div>
                    <div class="iv-grid rm-insp-grid" id="biGrid"></div>
                </div>
                <div class="rm-insp-list" id="biList"></div>
            </div>
            <div class="modal-footer justify-content-between">
                <form asp-action="DeleteBox" method="post" class="rm-confirm" data-msg="Delete this box? Only possible when it is empty.">
                    <input type="hidden" name="id" id="biDeleteId" />
                    <button class="iv-btn iv-btn-danger"><i class="bi bi-trash3-fill"></i> Delete box</button>
                </form>
                <button type="button" class="iv-btn iv-btn-primary" onclick="RM.editBoxFromInspector()"><i class="bi bi-pencil-fill"></i> Edit box</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/inventory.js" asp-append-version="true"></script>
    <script src="~/js/rooms.js" asp-append-version="true"></script>
    @if (TempData["Success"] != null)
    {
        <script>Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Success"]!.ToString()!))', showConfirmButton: false, timer: 3000, timerProgressBar: true });</script>
    }
    @if (TempData["Error"] != null)
    {
        <script>Swal.fire({ icon: 'error', title: 'Not done', text: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Error"]!.ToString()!))', confirmButtonColor: '#032b42' });</script>
    }
}
