@model LotViewModel
@{
    var canItem = AuthorizationService.AuthorizeAsync(User, Permissions.Items.Details).Result.Succeeded;
    var canLot = AuthorizationService.AuthorizeAsync(User, Permissions.Lots.Details).Result.Succeeded;
    var today = DateTime.Today;
    int n = 0;
}

<div class="modal fade iv-modal" id="ExpieryLotsModal" tabindex="-1" aria-hidden="true" dir="ltr">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bad">
                <h5 class="modal-title"><i class="bi bi-calendar-x-fill"></i> Expired Lots <span class="badge rounded-pill bg-light text-danger ms-1">@Model.ExpiryLotsList.Count</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!Model.ExpiryLotsList.Any())
                {
                    <div class="iv-empty">
                        <i class="bi bi-patch-check-fill" style="color:var(--iv-ok)"></i>
                        <h5>No expired lots</h5>
                        <p>Everything in storage is within its expiry date.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="iv-table" id="tableRole">
                            <thead>
                                <tr>
                                    <th>Lot</th>
                                    <th>Item</th>
                                    <th>Expired</th>
                                    <th>Total Qty</th>
                                    <th>Available</th>
                                    <th>Location</th>
                                    <th>SDS</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lot in Model.ExpiryLotsList)
                                {
                                    var ago = lot.ExpiryDate == null ? 0 : (today - lot.ExpiryDate.Value.Date).Days;
                                    <tr class="row-bad" style="animation:ivRise .4s @(Math.Min(n++, 12) * 35)ms both">
                                        <td><span class="iv-code"><img src="@lot.BarcodeImage" alt="" /><span>@lot.LotNumber</span></span></td>
                                        <td class="text-start">
                                            @if (canItem)
                                            {
                                                <a class="iv-name" asp-controller="Items" asp-action="SelectedItem" asp-route-Id="@lot.ItemId">@lot.Item?.Name</a>
                                            }
                                            else
                                            {
                                                <span class="iv-name">@lot.Item?.Name</span>
                                            }
                                        </td>
                                        <td><div class="iv-exp bad"><b>@lot.ExpiryDate?.ToString("dd MMM yyyy")</b><small>@(ago == 0 ? "today" : $"{ago}d ago")</small></div></td>
                                        <td><span class="iv-qty">@lot.TotalQuantity</span></td>
                                        <td><span class="iv-qty @(lot.AvilableQuantity > 0 ? "low" : "zero")">@lot.AvilableQuantity</span></td>
                                        <td><span class="iv-sub fw-bold"><i class="bi bi-geo-alt"></i> @(lot.ShortLocation ?? "—")</span></td>
                                        <td><span class="iv-pill @(lot.SDS == true ? "ok" : "bad")">@(lot.SDS == true ? "Valid" : "Invalid")</span></td>
                                        <td>
                                            @if (canLot)
                                            {
                                                <a class="iv-icon-btn" data-tip="Details" asp-controller="Lots" asp-action="SelectedLot" asp-route-Id="@lot.Id"><i class="bi bi-eye-fill"></i></a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
