@inject IAuthorizationService AuthorizationService
@inject UserManager<ApplicationUser> userManager
@model LotViewModel
@{
    ViewData["Title"] = "Lot: " + Model?.NewLot?.LotNumber;
    int tNo = 0;
}

<!-- Hero Header -->
<div class="lot-hero" dir="ltr">
    <div class="container-fluid">
        <!--  Modern Pill (Recommended) -->
        <nav aria-label="breadcrumb" class="breadcrumb-nav-pill mx-auto text-center justify-content-center" dir="ltr">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-step completed">
                    <a asp-controller="Lots" asp-action="Index" class="step-link">
                        <span class="step-icon"><i class="bi bi-archive-fill"></i></span>
                        <span class="step-label">Lots</span>
                    </a>
                    <span class="step-arrow"><i class="bi bi-chevron-right"></i></span>
                </li>
                <li class="breadcrumb-step active">
                    <span class="step-icon"><i class="bi bi-upc-scan"></i></span>
                    <span class="step-label">@Model?.NewLot?.LotNumber</span>
                </li>
            </ol>
        </nav>

        @* <h1 class="lot-title">@ViewData["Title"]</h1>
        <div class="lot-badge">
            <i class="bi bi-box-seam"></i>
            @(Model?.NewLot?.Item?.Name ?? "Unknown Item")
        </div> *@
    </div>
</div>

<div class="container-fluid" dir="ltr">
    <!-- Action Buttons -->
    <div class="action-bar">
        @if (AuthorizationService.AuthorizeAsync(User, Permissions.Lots.Print_LotBarcode).Result.Succeeded)
        {
            <a class="btn btn-lot-action btn-barcode"
               asp-controller="Lots" asp-action="PrintLotBarcode"
               asp-route-barcodeFile="@Model.NewLot.BarcodeImage"
               asp-route-ItemName="@Model.NewLot.Item.Name"
               asp-route-LotNumber="@Model.NewLot.LotNumber"
               asp-route-ExpiryDate="@Model.NewLot.ExpiryDate">
                <i class="bi bi-upc-scan fs-5"></i>
                <span>Print Barcode</span>
            </a>
        }
        @if (AuthorizationService.AuthorizeAsync(User, Permissions.Lots.Create_Lots).Result.Succeeded)
        {
            <a class="btn btn-lot-action btn-new-lot ms-auto justify-content-between"
               asp-controller="Items" asp-action="CreateLot"
               asp-route-Id="@Model.NewLot.ItemId">
                <i class="bi bi-cart-plus-fill fs-5"></i>
                <span>Create New Lot</span>
            </a>
        }
    </div>

    <div class="row g-4">
        <!-- Left: Lot Details -->
        <div class="col-lg-3">
            <div class="lot-card">
                <div class="card-header-lot" style="background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);">
                    <div class="header-icon" style="background: var(--primary-mid);">
                        <i class="bi bi-clipboard-data-fill" style="color: #fff;"></i>
                    </div>
                    <span class="header-title" style="color: var(--primary-dark);">Lot Details</span>
                </div>
                <div class="card-body-lot">
                    <!-- Lot Barcode -->
                    <div class="barcode-display mb-3">
                        <img src="@Model?.NewLot?.BarcodeImage" alt="Lot Barcode" />
                        <div class="mt-2 text-muted small fw-bold">@Model?.NewLot?.LotNumber</div>
                    </div>

                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-hash"></i> Lot Number</span>
                        <span class="info-value">@Model?.NewLot?.LotNumber</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-calendar-x-fill text-danger"></i> Expiry Date</span>
                        <span class="info-value">@Model?.NewLot?.ExpiryDate?.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-calendar-check-fill text-success"></i> Manufacture</span>
                        <span class="info-value">@Model?.NewLot?.ManufactureDate?.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-calendar-plus-fill text-primary"></i> Received</span>
                        <span class="info-value">@Model?.NewLot?.ReceivedDate?.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-boxes"></i> Quantity</span>
                        <span class="info-value">@Model?.NewLot?.TotalQuantity?.ToString("N2")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-shield-fill-check"></i> SDS Status</span>
                        @if (Model?.NewLot?.SDS == true)
                        {
                            <span class="info-value text-success"><i class="bi bi-check-circle-fill me-1"></i>Valid</span>
                        }
                        else
                        {
                            <span class="info-value text-danger"><i class="bi bi-x-circle-fill me-1"></i>Invalid</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <!-- Item Info Card -->
            <div class="lot-card">
                <div class="card-header-lot" style="background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);">
                    <div class="header-icon" style="background: var(--danger);">
                        <i class="bi bi-box-seam" style="color: #fff;"></i>
                    </div>
                    <span class="header-title" style="color: #c62828;">Item Information</span>
                </div>
                <div class="card-body-lot">
                    <div class="barcode-display mb-3">
                        <img src="@Model?.NewLot?.Item?.BarcodeImage" alt="Item Barcode" />
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-upc"></i> Item Code</span>
                        <span class="info-value">@Model?.NewLot?.Item?.Code</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-tag-fill"></i> Item Name</span>
                        <span class="info-value">@Model?.NewLot?.Item?.Name</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Storage Location Visual -->
        <div class="col-lg-6">
            <div class="lot-card">
                <div class="card-header-lot" style="background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);">
                    <div class="header-icon" style="background: var(--success);">
                        <i class="bi bi-geo-alt-fill" style="color: #fff;"></i>
                    </div>
                    <span class="header-title" style="color: #2e7d32;">Storage Location</span>
                </div>
                <div class="card-body-lot d-flex gap-3">
                    <div class="storage-visual col-6">
                        <div class="storage-path">
                            <!-- Building / Room -->
                            <div class="storage-node">
                                <div class="node-icon building">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div class="node-content">
                                    <div class="node-label">Room</div>
                                    <div class="node-value">@(Model?.NewLot?.Box?.Shelf?.StorageUnit?.Room?.Name ?? "N/A")</div>
                                </div>
                            </div>
                            <div class="node-arrow"><i class="bi bi-chevron-down"></i></div>

                            <!-- Storage Unit -->
                            <div class="storage-node">
                                <div class="node-icon unit">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                                <div class="node-content">
                                    <div class="node-label">Storage Unit</div>
                                    <div class="node-value">@(Model?.NewLot?.Box?.Shelf?.StorageUnit?.Name ?? "N/A")</div>
                                </div>
                            </div>
                            <div class="node-arrow"><i class="bi bi-chevron-down"></i></div>

                            <!-- Shelf -->
                            <div class="storage-node">
                                <div class="node-icon shelf">
                                    <i class="bi bi-layers"></i>
                                </div>
                                <div class="node-content">
                                    <div class="node-label">Shelf</div>
                                    <div class="node-value">@(Model?.NewLot?.Box?.Shelf?.Name ?? "N/A")</div>
                                </div>
                            </div>
                            <div class="node-arrow"><i class="bi bi-chevron-down"></i></div>

                            <!-- Box -->
                            <div class="storage-node">
                                <div class="node-icon box">
                                    <i class="bi bi-grid-3x3"></i>
                                </div>
                                <div class="node-content">
                                    <div class="node-label">Box</div>
                                    <div class="node-value">@(Model?.NewLot?.Box?.Name ?? "N/A")</div>
                                    <div class="text-muted small">@Model?.NewLot?.Box?.RowsCount × @Model?.NewLot?.Box?.ColumnsCount grid</div>
                                </div>
                            </div>
                            <div class="node-arrow"><i class="bi bi-chevron-down"></i></div>

                            <!-- Slot Position -->
                            <div class="storage-node">
                                <div class="node-icon slot">
                                    <i class="bi bi-geo-fill"></i>
                                </div>
                                <div class="node-content">
                                    <div class="node-label">Slot Position</div>
                                    <div class="node-value">Row @Model?.NewLot?.RowIndex, Column @Model?.NewLot?.ColumnIndex</div>
                                </div>
                            </div>
                        </div> 
                    </div>
                    <div class="storage-visual col-6">
                        <!-- Slot Grid Visual -->
                        @if (Model?.NewLot?.Box != null)
                        {
                            <div class="mt-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-muted small"><i class="bi bi-grid-3x3 me-1"></i>Box Grid View</span>
                                    <span class="badge bg-primary-subtle text-primary small">
                                        <i class="bi bi-geo-fill me-1"></i>Current Position
                                    </span>
                                </div>
                                <div class="slot-grid-visual" style="grid-template-columns: repeat(@Model.NewLot.Box.ColumnsCount, 1fr);">
                                    @for (int r = 1; r <= Model.NewLot.Box.RowsCount; r++)
                                    {
                                        @for (int c = 1; c <= Model.NewLot.Box.ColumnsCount; c++)
                                        {
                                            var isCurrent = (r == Model.NewLot.RowIndex && c == Model.NewLot.ColumnIndex);
                                            var cellClass = isCurrent ? "current" : "empty";
                                            <div class="slot-cell @cellClass" title="Row @(r), Col @(c)">
                                                @if (isCurrent)
                                                {
                                                    <i class="bi bi-geo-fill"></i>
                                                }
                                                else
                                                {
                                                    <span>@(r),@(c)</span>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="lot-card">
                <div class="card-header-lot" style="background: linear-gradient(135deg, #eceff1 0%, #cfd8dc 100%);">
                    <div class="header-icon" style="background:#37474f;">
                        <i class="bi bi-arrow-left-right" style="color: #fff;"></i>
                    </div>
                    <span class="header-title" style="color:#37474f;">Lot Transactions</span>
                </div>
                <div class="card-body-lot">
                    @if (!Model.LotTransactionsList.Any())
                    {
                        <div class="tx-empty">
                            <i class="bi bi-inbox"></i>
                            <h5>No Transactions Yet</h5>
                            <p class="text-muted small mb-0">This lot has no transaction history.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="tx-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Date</th>
                                        <th>Statement</th>
                                        <th>Created By</th>
                                        <th>Device</th>
                                        <th>Qty</th>
                                        <th>Available</th>
                                        <th>Recipient</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var trans in Model.LotTransactionsList)
                                    {
                                        tNo++;
                                        <tr>
                                            <td class="fw-bold text-muted">@trans.Move_Num</td>
                                            <td>@Convert.ToDateTime(trans.Move_Date).ToString("yyyy-MM-dd")</td>
                                            <td>@trans.Move_Statement</td>
                                            <td><i class="bi bi-person-circle me-1 text-muted"></i>@trans.CreatedBy</td>
                                            <td><i class="bi bi-laptop me-1 text-muted"></i>@trans.DeviceUsing</td>
                                            <td>
                                                @if (trans.Move_State == true)
                                                {
                                                    <span class="tx-badge in"><i class="bi bi-arrow-up-circle-fill"></i>+@trans.Move_Quantity</span>
                                                }
                                                else
                                                {
                                                    <span class="tx-badge out"><i class="bi bi-arrow-down-circle-fill"></i>-@trans.Move_Quantity</span>
                                                }
                                            </td>
                                            <td class="fw-bold text-primary">@trans.Total_Quantity</td>
                                            <td>@trans.Recipient</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
