@model ItemViewModel
@{
    ViewData["Title"] = "Exchange Lot";
    var item = Model.NewItem;
    var today = DateTime.Today;
    var lots = Model.LotsList ?? new List<Lot>();
    var cold = item?.StorageUnitType?.TemperatureValue < 0;

    (string Cls, string Text, int? Days) Exp(DateTime? d)
    {
        if (d == null) return ("muted", "No expiry", null);
        var days = (d.Value.Date - today).Days;
        return days <= 0 ? ("bad", "Expired", days) : days <= 30 ? ("warn", "Near expiry", days) : ("ok", "Valid", days);
    }
    int n = 0;
}
<link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />
<style>
    .iv-lots { display: grid; gap: 10px; }
    .iv-lot-opt input { position: absolute; opacity: 0; pointer-events: none; }
    .iv-lot-opt label {
        display: grid; grid-template-columns: auto 1fr auto auto; gap: 14px; align-items: center; padding: 12px 14px; cursor: pointer;
        border: 1.5px solid var(--iv-line); border-radius: 14px; background: #fff; transition: all .25s var(--iv-ease); animation: ivRise .4s var(--iv-ease) both; position: relative;
    }
    .iv-lot-opt label:hover { border-color: var(--iv-teal); transform: translateX(3px); }
    .iv-lot-opt input:checked + label { border-color: var(--iv-gold); background: linear-gradient(90deg, var(--iv-gold-soft), #fff 60%); box-shadow: 0 8px 20px rgba(197,165,71,.22); }
    .iv-lot-opt .radio { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--iv-line); display: grid; place-items: center; transition: .2s; }
    .iv-lot-opt input:checked + label .radio { border-color: var(--iv-gold); background: var(--iv-gold); box-shadow: inset 0 0 0 4px #fff; }
    .iv-fefo { position: absolute; top: -9px; left: 16px; background: var(--iv-navy); color: var(--iv-gold); font-size: .62rem; font-weight: 800; letter-spacing: 1px; padding: 2px 8px; border-radius: 6px; }
    .iv-after { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; border-radius: 14px; background: #f6f9fb; border: 1px dashed var(--iv-line); margin-top: 12px; }
    .iv-after b { font-size: 1.3rem; font-variant-numeric: tabular-nums; transition: color .2s; }
    .iv-after .bar { flex: 1; height: 8px; border-radius: 8px; background: #e6edf3; margin: 0 14px; overflow: hidden; }
    .iv-after .bar span { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, var(--iv-teal), var(--iv-ok)); transition: width .4s var(--iv-ease); }
    .iv-after.empty .bar span { background: var(--iv-bad); }
    .iv-quick { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
    .iv-quick button { border: 1.5px solid var(--iv-line); background: #fff; border-radius: 8px; padding: 3px 10px; font-size: .78rem; font-weight: 700; color: var(--iv-navy); transition: .2s; }
    .iv-quick button:hover { border-color: var(--iv-gold); background: var(--iv-gold-soft); }
</style>

<!-- ═════════ HERO ═════════ -->
<div class="iv-hero" dir="ltr">
    <div class="iv-hero-orb"></div>
    <div class="container-fluid">
        <nav class="iv-crumbs">
            <a asp-controller="Items" asp-action="Index"><i class="bi bi-boxes"></i> Items</a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Items" asp-action="SelectedItem" asp-route-id="@item?.Id">@item?.Name</a>
            <i class="bi bi-chevron-right"></i>
            <span>Exchange</span>
        </nav>
        <div class="iv-hero-row">
            <div class="iv-hero-id">
                <div class="iv-hero-icon"><i class="bi bi-cart-dash-fill"></i></div>
                <div>
                    <h1 class="iv-hero-title">Exchange Lot</h1>
                    <p class="iv-hero-sub">@item?.Name — the first-expiring lot is pre-selected (FEFO).</p>
                </div>
            </div>
            <div class="iv-hero-chips">
                <div class="iv-hero-chip gold"><b>@item?.AvilableQuantity</b><small>Total available</small></div>
                <div class="iv-hero-chip"><b>@lots.Count</b><small>Lots in stock</small></div>
            </div>
        </div>
    </div>
</div>

<form method="post" id="exForm" class="iv-form" dir="ltr">
    <div class="container-fluid pb-4">
        <input hidden asp-for="NewLot.ItemId" value="@item?.Id" />
        <input hidden id="lotId" asp-for="NewLot.Id" />
        <input hidden id="lotNum" asp-for="NewLot.LotNumber" />

        <div class="row g-4">
            <!-- Lots -->
            <div class="col-xl-7">
                <div class="iv-panel">
                    <div class="iv-panel-head gold">
                        <div class="ph-icon"><i class="bi bi-archive-fill"></i></div>
                        <div><h5>Choose lot</h5><small>Sorted by expiry</small></div>
                    </div>
                    <div class="iv-panel-body">
                        @if (!lots.Any())
                        {
                            <div class="iv-empty"><i class="bi bi-inbox"></i><h5>No available lots</h5></div>
                        }
                        else
                        {
                            <div class="iv-lots" id="lotList">
                                @foreach (var lot in lots)
                                {
                                    var e = Exp(lot.ExpiryDate);
                                    var first = n == 0;
                                    <div class="iv-lot-opt">
                                        <input type="radio" name="lotPick" id="lp_@lot.Id" value="@lot.Id" @(first ? "checked" : "")
                                               data-code="@lot.LotNumber" data-barcode="@lot.BarcodeImage" data-available="@lot.AvilableQuantity"
                                               data-loc="@lot.ShortLocation" />
                                        <label for="lp_@lot.Id" style="animation-delay:@(n++ * 50)ms">
                                            @if (first) { <span class="iv-fefo">FEFO PICK</span> }
                                            <span class="radio"></span>
                                            <span>
                                                <span class="iv-name" style="font-family:ui-monospace,Consolas,monospace">@lot.LotNumber</span>
                                                <span class="iv-sub d-block"><i class="bi bi-geo-alt"></i> @(lot.ShortLocation ?? "No location")</span>
                                            </span>
                                            <span class="iv-exp @e.Cls"><b>@lot.ExpiryDate?.ToString("dd MMM yy")</b><small>@(e.Days == null ? "" : e.Days <= 0 ? "expired" : $"in {e.Days}d")</small></span>
                                            <span class="iv-qty">@lot.AvilableQuantity</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Exchange -->
            <div class="col-xl-5">
                <div class="iv-panel" style="position:sticky;top:20px">
                    <div class="iv-panel-head teal">
                        <div class="ph-icon"><i class="bi bi-arrow-up-right-circle-fill"></i></div>
                        <div><h5>Dispense</h5><small>Quantity & recipient</small></div>
                    </div>
                    <div class="iv-panel-body">
                        <div class="iv-barcode-big">
                            <img id="lotBarcode" src="@Model.NewLot?.BarcodeImage" alt="Lot barcode" />
                            <b id="lotNumber">@Model.NewLot?.LotNumber</b>
                        </div>

                        <div class="iv-field">
                            <label>Quantity to exchange</label>
                            <div class="iv-stepper-num">
                                <button type="button" data-step="-1">−</button>
                                <input id="lotExQnty" type="number" min="1" asp-for="NewLot.ExchageQuantity" value="" class="form-control" required />
                                <button type="button" data-step="1">+</button>
                            </div>
                            <div class="iv-quick">
                                <button type="button" data-q="1">1</button>
                                <button type="button" data-q="0.25">¼</button>
                                <button type="button" data-q="0.5">½</button>
                                <button type="button" data-q="all">All</button>
                            </div>
                            <span asp-validation-for="NewLot.ExchageQuantity" class="text-danger small"></span>
                        </div>

                        <div class="iv-after" id="after">
                            <span class="iv-sub fw-bold">Remaining in lot</span>
                            <div class="bar"><span id="afterBar"></span></div>
                            <b id="afterQty">—</b>
                        </div>

                        <div class="iv-field mt-3">
                            <label>Recipient</label>
                            <div class="iv-input-icon">
                                <i class="bi bi-person-badge"></i>
                                <input id="lotRec" asp-for="NewLot.Recipient" class="form-control" placeholder="Who receives it?" required />
                            </div>
                            <span asp-validation-for="NewLot.Recipient" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="iv-actionbar">
                        <a asp-controller="Items" asp-action="Index" class="iv-btn iv-btn-ghost">Cancel</a>
                        <button type="submit" class="iv-btn iv-btn-gold" asp-action="Exchange" asp-controller="Lots" id="btnExchange">
                            <i class="bi bi-cart-dash-fill"></i> Exchange
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/inventory.js" asp-append-version="true"></script>
    <script>
        (() => {
            const $ = id => document.getElementById(id);
            const qty = $('lotExQnty');
            let max = 0;

            function pickLot() {
                const r = document.querySelector('input[name="lotPick"]:checked');
                if (!r) return;
                max = parseFloat(r.dataset.available) || 0;
                $('lotId').value = r.value;
                $('lotNum').value = r.dataset.code;
                $('lotBarcode').src = r.dataset.barcode;
                $('lotNumber').textContent = r.dataset.code;
                qty.max = max;
                qty.value = '';
                qty.placeholder = 'Max ' + max;
                after();
                qty.focus();
            }

            function after() {
                const q = Math.min(max, Math.max(0, parseFloat(qty.value) || 0));
                if (parseFloat(qty.value) > max) qty.value = max;
                const left = +(max - q).toFixed(3);
                $('afterQty').textContent = left;
                $('afterBar').style.width = (max ? left / max * 100 : 0) + '%';
                $('after').classList.toggle('empty', left === 0 && q > 0);
                $('afterQty').style.color = left === 0 && q > 0 ? 'var(--iv-bad)' : '';
            }

            document.querySelectorAll('input[name="lotPick"]').forEach(r => r.addEventListener('change', pickLot));
            qty.addEventListener('input', after);
            document.querySelectorAll('.iv-quick button').forEach(b => b.addEventListener('click', () => {
                qty.value = b.dataset.q === 'all' ? max : b.dataset.q === '1' ? Math.min(1, max) : Math.max(1, Math.floor(max * parseFloat(b.dataset.q)));
                after();
            }));
            pickLot();

            $('exForm').addEventListener('submit', e => {
                const q = parseFloat(qty.value);
                const missing = [];
                if (!q || q <= 0 || q > max) missing.push(`Quantity (1 – ${max})`);
                if (!$('lotRec').value.trim()) missing.push('Recipient');
                if (missing.length) {
                    e.preventDefault();
                    Swal.fire({ icon: 'warning', title: 'Check the exchange', html: '<b>' + missing.join('<br>') + '</b>', confirmButtonColor: '#032b42' });
                    return;
                }
                if (q === max && !$('exForm').dataset.ok) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'question', title: 'Empty this lot?', text: 'The full quantity will be exchanged and the lot closed.',
                        showCancelButton: true, confirmButtonText: 'Yes, exchange all', confirmButtonColor: '#032b42'
                    }).then(r => { if (r.isConfirmed) { $('exForm').dataset.ok = 1; $('btnExchange').click(); } });
                }
            });
        })();
    </script>
}
