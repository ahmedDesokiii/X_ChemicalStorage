@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<style>
    /* ========== HOME LANDING PAGE ========== */
    .home-landing {
        position: relative;
        min-height: calc(110vh - 75px);
        overflow: hidden;
        background: linear-gradient(160deg, #032b42 0%, #032b42 40%, #032b42 100%);
        color: #fff;
    }

    /* Animated particles / orbs */
    .home-orbs {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
    }

    .home-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        opacity: 0.4;
        animation: homeOrb 20s ease-in-out infinite;
    }

    .home-orb-1 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, #C5A547 0%, transparent 70%);
        top: -180px;
        left: -100px;
        animation-delay: 0s;
    }

    .home-orb-2 {
        width: 420px;
        height: 420px;
        background: radial-gradient(circle, #1a7a5c 0%, transparent 70%);
        bottom: -120px;
        right: -80px;
        animation-delay: -7s;
    }

    .home-orb-3 {
        width: 320px;
        height: 320px;
        background: radial-gradient(circle, #3F9AAE 0%, transparent 70%);
        top: 45%;
        left: 60%;
        animation-delay: -14s;
    }
    @@keyframes homeOrb {
        0%, 100% {
            transform: translate(0,0) scale(1);
        }

        33% {
            transform: translate(50px,-40px) scale(1.1);
        }

        66% {
            transform: translate(-40px,30px) scale(0.92);
        }
    }

    /* Grid lines */
    .home-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(197,165,71,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(197,165,71,0.06) 1px, transparent 1px);
        background-size: 60px 60px;
        z-index: 0;
        mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
    }

    /* Content */
    .home-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 140px);
        padding: 40px 20px;
        text-align: center;
    }

    /* Logo entrance */
    .home-logo-wrap {
        position: relative;
        margin-bottom: 28px;
        opacity: 0;
        transform: scale(0.6) translateY(40px);
        animation: logoIn 1.1s cubic-bezier(0.22,1,0.36,1) 0.2s forwards;
    }
    @@keyframes logoIn {
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .home-logo-wrap img {
        width: 160px;
        height: auto;
        filter: drop-shadow(0 0 30px rgba(197,165,71,0.45));
        transition: filter 0.4s ease, transform 0.4s ease;
    }

    .home-logo-wrap:hover img {
        filter: drop-shadow(0 0 50px rgba(197,165,71,0.7));
        transform: scale(1.05);
    }

    .home-logo-ring {
        position: absolute;
        inset: -18px;
        border: 2px solid rgba(197,165,71,0.35);
        border-radius: 50%;
        animation: ringPulse 3s ease-in-out infinite;
    }

    .home-logo-ring-2 {
        inset: -32px;
        border-color: rgba(197,165,71,0.18);
        animation-delay: -1.5s;
    }
    @@keyframes ringPulse {
        0%, 100% {
            transform: scale(1);
            opacity: 0.7;
        }

        50% {
            transform: scale(1.08);
            opacity: 1;
        }
    }

    /* Title */
    .home-title {
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        font-weight: 800;
        letter-spacing: 1px;
        margin-bottom: 8px;
        background: linear-gradient(90deg, #fff 0%, #C5A547 50%, #fff 100%);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: titleShine 4s linear infinite, titleIn 0.9s cubic-bezier(0.22,1,0.36,1) 0.5s both;
    }
    @@keyframes titleShine {
        to {
            background-position: 200% center;
        }
    }
    @@keyframes titleIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .home-subtitle {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.7);
        margin-bottom: 36px;
        letter-spacing: 2px;
        text-transform: uppercase;
        opacity: 0;
        animation: fadeUp 0.8s 0.7s forwards;
    }
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Feature cards */
    .home-features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 18px;
        max-width: 900px;
        width: 100%;
        margin-bottom: 40px;
    }

    .home-feature {
        background: rgba(255,255,255,0.06);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 18px;
        padding: 24px 18px;
        transition: all 0.4s cubic-bezier(0.22,1,0.36,1);
        opacity: 0;
        transform: translateY(40px);
        animation: cardUp 0.7s cubic-bezier(0.22,1,0.36,1) forwards;
        cursor: default;
    }

        .home-feature:nth-child(1) {
            animation-delay: 0.85s;
        }

        .home-feature:nth-child(2) {
            animation-delay: 0.95s;
        }

        .home-feature:nth-child(3) {
            animation-delay: 1.05s;
        }

        .home-feature:nth-child(4) {
            animation-delay: 1.15s;
        }

    @@keyframes cardUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .home-feature:hover {
        background: rgba(197,165,71,0.12);
        border-color: rgba(197,165,71,0.4);
        transform: translateY(-8px);
        box-shadow: 0 16px 40px rgba(0,0,0,0.3);
    }

    .home-feature i {
        font-size: 2rem;
        color: #C5A547;
        margin-bottom: 12px;
        display: block;
        transition: transform 0.3s ease;
    }

    .home-feature:hover i {
        transform: scale(1.15);
    }

    .home-feature h5 {
        font-weight: 700;
        font-size: 1.05rem;
        margin-bottom: 6px;
        color: #fff;
    }

    .home-feature p {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.6);
        margin: 0;
        line-height: 1.4;
    }

    /* CTA Buttons */
    .home-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        justify-content: center;
        opacity: 0;
        animation: fadeUp 0.8s 1.3s forwards;
    }

    .home-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 28px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.35s cubic-bezier(0.22,1,0.36,1);
        position: relative;
        overflow: hidden;
    }

        .home-btn::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transform: translateX(-100%);
            transition: transform 0.5s ease;
        }

        .home-btn:hover::after {
            transform: translateX(100%);
        }

    .home-btn-primary {
        background: linear-gradient(135deg, #C5A547, #a88b2e);
        color: #1a1a1a;
        box-shadow: 0 8px 24px rgba(197,165,71,0.4);
    }

        .home-btn-primary:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 14px 36px rgba(197,165,71,0.55);
            color: #1a1a1a;
        }

    .home-btn-outline {
        background: transparent;
        color: #fff;
        border: 2px solid rgba(255,255,255,0.35);
    }

        .home-btn-outline:hover {
            background: rgba(255,255,255,0.1);
            border-color: #C5A547;
            color: #C5A547;
            transform: translateY(-4px);
        }

    /* Floating particles (small dots) */
    .home-particles {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        overflow: hidden;
    }

    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(197,165,71,0.6);
        border-radius: 50%;
        animation: particleFloat linear infinite;
    }
    @@keyframes particleFloat {
        0% {
            transform: translateY(100vh) scale(0);
            opacity: 0;
        }

        10% {
            opacity: 1;
        }

        90% {
            opacity: 1;
        }

        100% {
            transform: translateY(-20px) scale(1);
            opacity: 0;
        }
    }

    /* Bottom strip */
    .home-footer-strip {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #032b42, #C5A547, #1a7a5c, #C5A547, #032b42);
        background-size: 200% 100%;
        animation: stripMove 6s linear infinite;
        z-index: 3;
    }
    @@keyframes stripMove {
        to {
            background-position: 200% 0;
        }
    }

    /* Responsive */
    @@media (max-width: 576px) {
        .home-logo-wrap img {
            width: 120px;
        }

        .home-features {
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .home-feature {
            padding: 16px 12px;
        }

        .home-btn {
            padding: 12px 20px;
            font-size: 0.9rem;
        }
    }
</style>

<div class="home-landing" dir="ltr">
    <!-- Background -->
    <div class="home-orbs">
        <div class="home-orb home-orb-1"></div>
        <div class="home-orb home-orb-2"></div>
        <div class="home-orb home-orb-3"></div>
    </div>
    <div class="home-grid"></div>
    <div class="home-particles" id="homeParticles"></div>

    <!-- Main Content -->
    <div class="home-content">
        <!-- Logo -->
        <div class="home-logo-wrap">
            <div class="home-logo-ring"></div>
            <div class="home-logo-ring home-logo-ring-2"></div>
            <img src="~/images/bc.png" alt="Biodefense Center Logo" />
        </div>

        <!-- Titles -->
        <h1 class="home-title">Biodefense Center</h1>
        <p class="home-subtitle">Infectious &amp; Emerging Diseases · Reagents Storage System</p>

        <!-- Feature Cards -->
        <div class="home-features">
            <div class="home-feature">
                <i class="bi bi-boxes"></i>
                <h5>Inventory</h5>
                <p>Full catalog &amp; lot tracking</p>
            </div>
            <div class="home-feature">
                <i class="bi bi-droplet"></i>
                <h5>Bio Bank</h5>
                <p>Cold storage visualization</p>
            </div>
            <div class="home-feature">
                <i class="bi bi-shield-check"></i>
                <h5>SDS &amp; Safety</h5>
                <p>Hazard alerts &amp; compliance</p>
            </div>
            <div class="home-feature">
                <i class="bi bi-speedometer2"></i>
                <h5>Dashboard</h5>
                <p>Real-time KPIs &amp; insights</p>
            </div>
        </div>

        <!-- CTA -->
        <div class="home-cta">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Home/MasterDashboard" class="home-btn home-btn-primary">
                    <i class="bi bi-speedometer2"></i> Go to Dashboard
                </a>
                <a href="/BioBank" class="home-btn home-btn-outline">
                    <i class="bi bi-droplet"></i> Bio Bank
                </a>
            }
            else
            {
                <a href="/Identity/Account/Login" class="home-btn home-btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </a>
                <a href="#" class="home-btn home-btn-outline">
                    <i class="bi bi-person-plus"></i> Register
                </a>
            }
        </div>
    </div>

    <div class="home-footer-strip"></div>
</div>

<script>
    // Floating particles
    (function () {
        const container = document.getElementById('homeParticles');
        if (!container) return;
        const count = 28;
        for (let i = 0; i < count; i++) {
            const p = document.createElement('div');
            p.className = 'particle';
            p.style.left = Math.random() * 100 + '%';
            p.style.animationDuration = (8 + Math.random() * 12) + 's';
            p.style.animationDelay = (Math.random() * 10) + 's';
            p.style.width = p.style.height = (2 + Math.random() * 4) + 'px';
            p.style.opacity = 0.3 + Math.random() * 0.5;
            container.appendChild(p);
        }
    })();
</script>