@inject IAuthorizationService AuthorizationService
@inject UserManager<ApplicationUser> userManager
@model ItemViewModel
@{
    ViewData["Title"] = "Create New Lot";
    string lotNumGenerate = Guid.NewGuid().ToString("N").Substring(0, 8);
}

<!-- Hero Header -->
<div class="lot-hero" dir="ltr">
    <div class="container-fluid">
        <!--  Modern Pill (Recommended) -->
        <nav aria-label="breadcrumb" class="breadcrumb-nav-pill mx-auto text-center justify-content-center" dir="ltr">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-step completed">
                    <a asp-controller="Items" asp-action="Index" class="step-link">
                        <span class="step-icon"><i class="bi bi-archive-fill"></i></span>
                        <span class="step-label">Items</span>
                    </a>
                    <span class="step-arrow"><i class="bi bi-chevron-right"></i></span>
                </li>
                <li class="breadcrumb-step active">
                    <span class="step-icon"><i class="bi bi-cart-plus-fill"></i></span>
                    <span class="step-label">@ViewData["Title"]</span>
                </li>
            </ol>
        </nav>
    </div>
</div>




<form  method="post">
    <section class="container-fluid mt-1 " dir="ltr">
        <div class="row ">
            <div class="col-md-4 col-12">
                <div class="card p-0 mt-0 shadow-sm" style="border-radius:16px; overflow:hidden;">
                    <div class="card-header py-2 d-flex align-items-center justify-content-start bg-danger-subtle">
                        <i class="bi bi-pin-angle-fill link-danger fs-4 pe-3"></i>
                        <span class="fs-4 fw-bold link-danger">Item Data</span>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body mx-auto">
                        <!-- Item Image -->
                        <div class="input-group mt-2 row mx-auto">
                            @* <img src="~/images/item.png" class="mx-auto w-50" /> *@
                        </div>
                        <!---------------------------- Item Data ----------------------------------->
                        <input hidden asp-for="@Model.NewLot.ItemId" value="@Model.NewItem.Id" class="form-control text-center fw-bold" style="border-top-right-radius : 20px ;">

                        <!-- Item Barcode -->
                        <div class="input-group mt-2 row mx-auto">
                            <span class="input-group-text bg-danger-subtle fw-bold rounded-end-3 col-md-4 col-3" id="inputGroup-sizing-default ">Item Barcode &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                            <div class="card col-md-8 col-9 py-1" style="border-top-right-radius : 20px ;">
                                <div class="card-body row p-0 mx-auto" style="border-top-right-radius : 20px ;">
                                    <img src="~/barcodes/0bfaec93.png" height="60" />
                                </div>
                            </div>
                        </div>
                        <!-- Item Code -->
                        <div class="input-group mt-2 row mx-auto">
                            <span class="input-group-text bg-danger-subtle fw-bold rounded-end-3 col-md-4 col-3" id="inputGroup-sizing-default ">Item Code &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                            <input readonly value="@Model.NewItem.Code" class="form-control text-center fw-bold col-md-8 col-9" autocomplete="on" aria-required="true" placeholder="Item Code ..." type="text" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-right-radius : 20px ;">
                        </div>
                        <!-- Item Name -->
                        <div class="input-group mt-2 row mx-auto">
                            <span class="input-group-text bg-danger-subtle fw-bold rounded-end-3 col-md-4 col-3" id="inputGroup-sizing-default ">Item Name &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                            <input readonly value="@Model.NewItem.Name" class="form-control text-center fw-bold col-md-8 col-9" autocomplete="on" aria-required="true" placeholder="Item Name ..." type="text" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-right-radius : 20px ;">
                        </div>

                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </div>
            </div>
            <div class="col-md-4 col-12">

                <div class="card p-0 mt-0 shadow-sm" style="border-radius:16px; overflow:hidden;">
                    <div class="card-header py-2 d-flex align-items-center justify-content-start bg-info-subtle">
                        <i class="bi bi-pin-angle-fill link-primary fs-4 pe-3"></i>
                        <span class="fs-4 fw-bold link-primary">Lot Data</span>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body mx-auto ">
                        <!-- Item Image -->
                        <div class="input-group mt-2 row mx-auto">
                        </div>

                        <!---------------------------- Lot Data ----------------------------------->
                        <!-- Lot Barcode -->
                        <div class="input-group mt-2 row mx-auto">
                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4 col-3" id="inputGroup-sizing-default ">Lot Barcode &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                            <span class="card col-md-8 col-9 py-1 border-start" style="border-top-right-radius : 20px ;">
                                <span class="col-md-8">
                                    <img src="~/lotbarcodes/184799d5.png" height="60" />
                                </span>
                            </span>
                        </div>

                        <!-- Lot Number -->
                        <div class="input-group mt-2 row mx-auto">
                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4 col-3" id="inputGroup-sizing-default ">Lot Number &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                            <span class="col-md-8 col-9">
                                <input id="lotNum" required asp-for="@Model.NewLot.LotNumber" value="@lotNumGenerate" class="form-control text-center fw-bold" autocomplete="on" aria-required="true" placeholder="Enter Lot Number" type="text" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-right-radius : 20px ;">
                            </span>
                        </div>

                            
                        <!-- Lot Quantity -->
                        <div class="input-group mt-2 row mx-auto">
                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4 col-3" id="inputGroup-sizing-default ">Lot Quantity &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                            <span class="col-md-8 col-9">
                                <input id="lotQnty" value="1" asp-for="@Model.NewLot.TotalQuantity" required class="form-control text-center " placeholder="Enter Quantity Lot " type="number" min="0" style="border-top-right-radius : 20px ;" autofocus>
                            </span>
                        </div>
                        <span asp-validation-for="@Model.NewLot.TotalQuantity" class="text-danger"></span>

                        <!-- Lot Expiry Date -->
                        <div class="input-group mt-2 row mx-auto">
                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4 col-3" id="inputGroup-sizing-default ">Expiry Date &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                            <span class="col-md-8 col-8">
                                <input type="date" id="lotExpiryDate" value="@DateTime.Now.ToShortDateString()" asp-for="@Model.NewLot.ExpiryDate" class="form-control text-center col-md-8 col-9" style="border-top-right-radius : 20px ;">
                            </span>
                        </div>
                        <span asp-validation-for="@Model.NewLot.ExpiryDate" class="text-danger"></span>
                        <!-- Lot Supplier -->
                        <div class="input-group mt-2 row mx-auto">
                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4 col-3" id="inputGroup-sizing-default ">Lot Supplier &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                            <span class="col-md-8 col-9">
                                <select id="lotSupp" class="form-select text-start " required asp-items="@Model.ListSuppliers" style="border-top-right-radius : 20px ;">
                                    <option selected disabled class="text-center " value=""> Choose Supplier </option>
                                </select>
                            </span>
                        </div>
                        <!-- Lot Manufacture Date -->
                        <div class="input-group mt-2 row mx-auto">
                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4 col-4" id="inputGroup-sizing-default ">Manufacture Date </span>
                            <span class="col-md-8 col-8">
                                <input type="date" id="lotManufactureDate" value="@DateTime.Now.ToShortDateString()" asp-for="@Model.NewLot.ManufactureDate" class="form-control text-center " style="border-top-right-radius : 20px ;">
                            </span>
                        </div>
                        <span asp-validation-for="@Model.NewLot.ManufactureDate" class="text-danger"></span>

                        <!-- Lot SDS -->
                        <div class="input-group mt-3 row mx-auto">
                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4 " id="inputGroup-sizing-default ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Lot SDS &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                            <div class="card col-md-8 py-0" style="border-top-right-radius : 20px ;">
                                <div class="card-body col-md-8 p-0 mx-auto" style="border-top-right-radius : 20px ;">
                                    <div class="row">
                                        @* <div class="col-md-1 col-1"></div> *@
                                        <div class="col-md-3 col-3 text-center my-0">
                                            <label for="sdsYes" class="radio-card" onclick="document.getElementById('itemSDS').value = 'True'; ">
                                                <input type="radio" hidden name="radio-card" id="sdsYes" />
                                                <div class="card-content-wrapper rounded-3 py-2 px-4">
                                                    <span class="bi bi-shield-fill-check link-success fs-3"></span>
                                                    <br class="m-0 p-0">
                                                    <span class="link-dark mb-0">Valid</span>
                                                </div>
                                            </label>
                                        </div>
                                        <div class="col-md-4 col-4 text-center"></div>
                                        <div class=" col-md-3 col-3 text-center my-0">
                                            <label for="sdsNo" class="radio-card" onclick="document.getElementById('itemSDS').value = 'False'; ">
                                                <input type="radio" hidden name="radio-card" id="sdsNo" />
                                                <div class="card-content-wrapper rounded-3 py-2 px-3">
                                                    <span class="bi bi-shield-x link-danger fs-3"></span>
                                                    <br class="m-0 p-0">
                                                    <span class="link-dark mb-0">Invalid</span>
                                                </div>
                                            </label>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <input id="itemSDS" required hidden asp-for="@Model.NewLot.SDS" class="form-control text-center" autocomplete="on" aria-required="true" placeholder="Enter Item SDS ..." type="text" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-right-radius : 20px ;">
                        </div>
                        <span asp-validation-for="@Model.NewLot.SDS" class="text-danger"></span>

                        <!-- /.card-body -->
                    </div>
                    <div class=" d-flex mx-auto py-3 mt-2 bg-transparent" style="padding:0 15px 15px 0">
                        <button class="btn btn-outline-primary btn-sm mx-2 d-flex rounded rounded-3 " type="submit" title="Print lot Barcode"
                                asp-controller="Lots"
                                asp-action="PrintLotBarcode"
                                asp-route-barcodeFile="@Model.NewLot.BarcodeImage"
                                asp-route-ItemName="@Model.NewItem.Name"
                                asp-route-LotNumber="@Model.NewLot.LotNumber"
                                asp-route-ExpiryDate="@Model.NewLot.ExpiryDate">
                            <img src="~/images/barcode.png" alt="SaveAndPrint" height="30" class="mx-2">
                            <span class="fw-bold fs-6 pt-1 pe-3">Print Barcode</span>
                        </button>
                        <input type="submit" class="btn btn-success mx-2" value="Save changes Only" id="btnSave" asp-action="Save" asp-controller="Lots" />
                    </div>
                    <!-- /.card -->
                </div>
            </div>
            <div class="col-md-4 col-12">
                <!-- Lot Storage Location -->
                <div class="card p-0 mt-0 shadow-sm" style="border-radius:16px; overflow:hidden;">
                    <div class="card-header py-2 bg-success-subtle d-flex align-items-center">
                        <i class="bi bi-geo-alt-fill link-success fs-4 pe-2"></i>
                        <span class="fw-bold link-success fs-5">Storage Location</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-2">
                            <div class="col-md-6 col-6">
                                <label class="form-label small fw-bold text-muted">Room</label>
                                <select id="selRoom" class="form-select">
                                    <option value="" selected disabled>Choose Room</option>
                                    @foreach (var r in Model.ListRooms)
                                    {
                                        <option value="@r.Value">@r.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                            </div>

                            <div class="col-md-4 col-6">
                                <label class="form-label small fw-bold text-muted">Storage Unit</label>
                                <select id="selUnit" class="form-select" disabled>
                                    <option value="" selected disabled>Choose Unit</option>
                                </select>
                            </div>
                            <div class="col-md-4 col-6">
                                <label class="form-label small fw-bold text-muted">Shelf</label>
                                <select id="selShelf" class="form-select" disabled>
                                    <option value="" selected disabled>Choose Shelf</option>
                                </select>
                            </div>
                            <div class="col-md-4 col-6">
                                <label class="form-label small fw-bold text-muted">Box</label>
                                <select id="selBox" class="form-select" disabled>
                                    <option value="" selected disabled>Choose Box</option>
                                </select>
                            </div>
                        </div>

                        <div id="gridWrapper" class="mt-4 text-center" style="display:none;">
                            <div class="d-flex justify-content-center gap-4 mb-3 small fw-bold">
                                <span><span class="legend-box legend-free"></span> Available</span>
                                <span><span class="legend-box legend-occupied"></span> Occupied</span>
                                <span><span class="legend-box legend-selected"></span> Selected</span>
                            </div>
                            <div class="table-responsive d-inline-block mx-auto">
                                <table id="boxGridTable" class="table table-bordered mb-0" style="width:auto;"></table>
                            </div>
                            <div class="mt-2 fw-bold text-primary" id="selectedSlotLabel">No slot selected yet</div>
                        </div>

                        <input type="hidden" asp-for="NewLot.BoxId" id="hiddenBoxId" />
                        <input type="hidden" asp-for="NewLot.RowIndex" id="hiddenRowIndex" />
                        <input type="hidden" asp-for="NewLot.ColumnIndex" id="hiddenColumnIndex" />
                        <span asp-validation-for="NewLot.BoxId" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
        <!-- /.row -->
    </section>
</form>
@section Scripts{
    <script>
        window.addEventListener("load", () => {
            const input = document.getElementById("lotQnty");

            setTimeout(() => {
                input.focus();
                input.select();
            }, 100);
        });

                const selRoom = document.getElementById('selRoom');
        const selUnit = document.getElementById('selUnit');
        const selShelf = document.getElementById('selShelf');
        const selBox = document.getElementById('selBox');

        function resetSelect(sel, placeholder) {
            sel.innerHTML = `<option value="" selected disabled>${placeholder}</option>`;
            sel.disabled = true;
        }

        function hideGrid() {
            document.getElementById('gridWrapper').style.display = 'none';
            document.getElementById('hiddenBoxId').value = '';
            document.getElementById('hiddenRowIndex').value = '';
            document.getElementById('hiddenColumnIndex').value = '';
        }

        selRoom.addEventListener('change', async () => {
            resetSelect(selUnit, 'Choose Unit');
            resetSelect(selShelf, 'Choose Shelf');
            resetSelect(selBox, 'Choose Box');
            hideGrid();

            const res = await fetch(`/Rooms/GetStorageUnitsByRoom?roomId=${selRoom.value}`);
            const units = await res.json();
            units.forEach(u => selUnit.add(new Option(u.name, u.id)));
            selUnit.disabled = false;
        });

        selUnit.addEventListener('change', async () => {
            resetSelect(selShelf, 'Choose Shelf');
            resetSelect(selBox, 'Choose Box');
            hideGrid();

            const res = await fetch(`/Rooms/GetShelvesByStorageUnit?storageUnitId=${selUnit.value}`);
            const shelves = await res.json();
            shelves.forEach(s => selShelf.add(new Option(s.name, s.id)));
            selShelf.disabled = false;
        });

        selShelf.addEventListener('change', async () => {
            resetSelect(selBox, 'Choose Box');
            hideGrid();

            const res = await fetch(`/Rooms/GetBoxesByShelf?shelfId=${selShelf.value}`);
            const boxes = await res.json();
            boxes.forEach(b => selBox.add(new Option(b.name, b.id)));
            selBox.disabled = false;
        });

        selBox.addEventListener('change', async () => {
            const res = await fetch(`/Rooms/GetBoxGrid?boxId=${selBox.value}`);
            const gridData = await res.json();
            if (!gridData) return;

            renderGrid(gridData);
            document.getElementById('hiddenBoxId').value = selBox.value;
            document.getElementById('gridWrapper').style.display = 'block';
        });

        function renderGrid(data) {
            const table = document.getElementById('boxGridTable');
            table.innerHTML = '';

            const occupiedMap = {};
            data.occupied.forEach(o => {
                occupiedMap[`${o.rowIndex}-${o.columnIndex}`] = o.lotNumber;
            });

            for (let r = 1; r <= data.rowsCount; r++) {
                const tr = document.createElement('tr');
                for (let c = 1; c <= data.columnsCount; c++) {
                    const td = document.createElement('td');
                    const key = `${r}-${c}`;

                    if (occupiedMap[key]) {
                        td.className = 'cell-occupied';
                        td.title = `Occupied by Lot: ${occupiedMap[key]}`;
                        td.innerHTML = '<i class="bi bi-x-lg" style="font-size:12px;color:#a94442;"></i>';
                    } else {
                        td.className = 'cell-free';
                        td.title = `Row ${r}, Column ${c}`;
                        td.addEventListener('click', () => selectCell(td, r, c));
                    }
                    tr.appendChild(td);
                }
                table.appendChild(tr);
            }
        }

        function selectCell(td, r, c) {
            document.querySelectorAll('.cell-selected').forEach(el => el.classList.remove('cell-selected'));
            td.classList.add('cell-selected');
            td.classList.remove('cell-free');
            td.classList.add('cell-free'); // يفضل قابل لإعادة الاختيار

            document.getElementById('hiddenRowIndex').value = r;
            document.getElementById('hiddenColumnIndex').value = c;
            document.getElementById('selectedSlotLabel').textContent = `Selected: Row ${r}, Column ${c}`;
        }

        // منع الحفظ من غير ما يختار مكان فعلي
        document.querySelector('form').addEventListener('submit', function (e) {
            const boxId = document.getElementById('hiddenBoxId').value;
            const rowIndex = document.getElementById('hiddenRowIndex').value;

            if (!boxId || !rowIndex) {
                e.preventDefault();
                Swal.fire({
                    title: 'Location Required',
                    text: 'Please select a storage slot before saving.',
                    icon: 'warning',
                    confirmButtonText: 'Ok'
                });
            }
        });
    </script>
}
<style>
    .cell-free {
        background: #d4edda;
        border: 1px solid #b7dfc0;
        width: 38px;
        height: 38px;
        cursor: pointer;
        text-align: center;
        vertical-align: middle;
        transition: .15s;
    }

        .cell-free:hover {
            background: #a9dcb5;
            transform: scale(1.05);
        }

    .cell-occupied {
        background: #f5c6cb;
        border: 1px solid #eab5ba;
        width: 38px;
        height: 38px;
        text-align: center;
        vertical-align: middle;
        cursor: not-allowed;
    }

    .cell-selected {
        background: #0d6efd !important;
        color: #fff;
    }

    .legend-box {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 3px;
        margin-left: 4px;
        vertical-align: middle;
    }

    .legend-free {
        background: #d4edda;
        border: 1px solid #b7dfc0;
    }

    .legend-occupied {
        background: #f5c6cb;
        border: 1px solid #eab5ba;
    }

    .legend-selected {
        background: #0d6efd;
    }
</style>
