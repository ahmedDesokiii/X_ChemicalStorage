@model ItemViewModel
@{
    ViewData["Title"] = "Inventory Catalog";

    var items = Model.ItemsList;
    var total = items.Count;
    var outOf = items.Count(x => x.AvilableQuantity <= 0);
    var low = items.Count(x => x.AvilableQuantity > 0 && x.AvilableQuantity <= x.Limit);
    var sdsBad = items.Count(x => x.SDS != true);
    var coldN = items.Count(x => x.StorageUnitType?.TemperatureValue < 0);

    bool can(string p) => AuthorizationService.AuthorizeAsync(User, p).Result.Succeeded;
    var canCreateItem = can(Permissions.Items.Create);
    var canCreateLot = can(Permissions.Lots.Create);
    var canDetails = can(Permissions.Items.Details);
    var canEdit = can(Permissions.Items.Edit);
    var canDelete = can(Permissions.Items.Delete);
    var canPrint = can(Permissions.Items.PrintBarcode);
    var canExchange = can(Permissions.Lots.Exchange);

    (string Row, string Cls, string Text) Stock(Item x) =>
        x.AvilableQuantity <= 0 ? ("row-bad", "bad", "Out of stock")
      : x.AvilableQuantity <= x.Limit ? ("row-warn", "warn", "Low stock")
      : ("row-ok", "ok", "In stock");

    int StockPct(Item x)
    {
        var target = Math.Max(1.0, Convert.ToDouble(x.Limit) * 3);       // full bar = 3× the reorder limit
        return (int)Math.Clamp(Convert.ToDouble(x.AvilableQuantity) * 100 / target, 0, 100);
    }
    int i = 0;
}
<link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />

<!-- ═════════ HERO ═════════ -->
<div class="iv-hero" dir="ltr">
    <div class="iv-hero-orb"></div>
    <div class="container-fluid">
        <div class="iv-hero-row">
            <div class="iv-hero-id">
                <div class="iv-hero-icon"><i class="bi bi-boxes"></i></div>
                <div>
                    <h1 class="iv-hero-title">Items</h1>
                    <p class="iv-hero-sub">Master catalog — stock levels, storage conditions and SDS compliance.</p>
                </div>
            </div>
            <div class="iv-hero-chips">
                <div class="iv-hero-chip"><b data-count="@total">0</b><small>Items</small></div>
                <div class="iv-hero-chip warn" style="animation-delay:.06s"><b data-count="@low">0</b><small>Low stock</small></div>
                <div class="iv-hero-chip bad" style="animation-delay:.12s"><b data-count="@outOf">0</b><small>Out of stock</small></div>
                <div class="iv-hero-chip gold" style="animation-delay:.18s"><b data-count="@coldN">0</b><small>Cold chain</small></div>
            </div>
        </div>
    </div>
</div>

<section class="container-fluid pb-4" dir="ltr">
    <!-- ═════════ ACTION TILES ═════════ -->
    <div class="iv-tiles">
        @if (canCreateItem)
        {
            <a class="iv-tile gold" onclick="ResetItem()" data-bs-toggle="modal" data-bs-target="#exampleModal">
                <i class="bi bi-plus-square-fill"></i>
                <span>New Item<small>Add to the master catalog</small></span>
            </a>
        }
        <a class="iv-tile ok" asp-controller="Lots" asp-action="Index">
            <i class="bi bi-archive-fill"></i>
            <span>Lots<small>Receive & exchange stock</small></span>
        </a>
        <a class="iv-tile bad" href="#" onclick="ivFilter('Low stock|Out of stock');return false;">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>Needs reorder<small>Filter low & empty items</small></span>
            @if (low + outOf > 0) { <em class="iv-tile-count">@(low + outOf)</em> }
        </a>
        <a class="iv-tile navy" href="#" onclick="ivFilter('Invalid');return false;">
            <i class="bi bi-shield-exclamation"></i>
            <span>SDS issues<small>Items without a valid SDS</small></span>
            @if (sdsBad > 0) { <em class="iv-tile-count">@sdsBad</em> }
        </a>
    </div>

    <div class="iv-panel">
        <div class="iv-panel-head">
            <div class="ph-icon"><i class="bi bi-grid-3x3-gap-fill"></i></div>
            <div><h5>Catalog</h5><small>Stock bar fills at 3× the reorder limit</small></div>
            <div class="ph-end">
                <a href="#" class="iv-pill muted text-decoration-none" onclick="ivFilter('');return false;"><i class="bi bi-x-circle"></i> Clear filter</a>
            </div>
        </div>

        @if (!items.Any())
        {
            <div class="iv-empty">
                <i class="bi bi-box"></i>
                <h5>No items yet</h5>
                <p>Create your first item to start receiving lots.</p>
                @if (canCreateItem)
                {
                    <button class="iv-btn iv-btn-gold" onclick="ResetItem()" data-bs-toggle="modal" data-bs-target="#exampleModal"><i class="bi bi-plus-lg"></i> New Item</button>
                }
            </div>
        }
        else
        {
            <!-- ───── Mobile ───── -->
            <div class="iv-mcards d-md-none">
                @foreach (var item in items)
                {
                    var s = Stock(item);
                    var cold = item.StorageUnitType?.TemperatureValue < 0;
                    var activeLots = item.Lots?.Count(x => x.AvilableQuantity > 0 && x.CurrentState > 0) ?? 0;
                    <div class="iv-mcard @s.Row" style="animation-delay:@(Math.Min(i++, 10) * 40)ms">
                        <div class="iv-mcard-head">
                            <h6>@item.Name</h6>
                            <span class="iv-code"><img src="@item.BarcodeImage" alt="" /><span>@item.Code</span></span>
                        </div>
                        <div class="iv-mcard-body">
                            <div><label>Stock</label><span class="iv-pill @s.Cls">@s.Text</span></div>
                            <div><label>Available</label><b>@item.AvilableQuantity <small class="iv-sub">/ limit @item.Limit</small></b></div>
                            <div><label>Active lots</label><span class="iv-qty">@activeLots</span></div>
                            <div><label>SDS</label><span class="iv-pill @(item.SDS == true ? "ok" : "bad")">@(item.SDS == true ? "Valid" : "Invalid")</span></div>
                            <div><label>Category</label><span>@item.Category?.Name</span></div>
                            <div><label>Storage</label><span class="iv-temp @(cold ? "cold" : "room")"><i class="bi bi-thermometer-half"></i>@item.StorageUnitType?.Name</span></div>
                        </div>
                        <div class="iv-mcard-foot">
                            @if (canCreateLot) { <a class="iv-icon-btn ok" data-tip="Receive lot" asp-controller="Items" asp-action="CreateLot" asp-route-Id="@item.Id"><i class="bi bi-cart-plus-fill"></i></a> }
                            @if (canExchange)
                            {
                                if (item.AvilableQuantity > 0) { <a class="iv-icon-btn cold" data-tip="Exchange" asp-controller="Items" asp-action="ExchangeLot" asp-route-Id="@item.Id"><i class="bi bi-cart-dash-fill"></i></a> }
                                else { <span class="iv-icon-btn locked" data-tip="Nothing available"><i class="bi bi-cart-dash-fill"></i></span> }
                            }
                            @if (canDetails) { <a class="iv-icon-btn" data-tip="Details" asp-controller="Items" asp-action="SelectedItem" asp-route-Id="@item.Id"><i class="bi bi-eye-fill"></i></a> }
                            @if (canEdit)
                            {
                                <a class="iv-icon-btn" data-tip="Edit" data-bs-toggle="modal" data-bs-target="#exampleModal"
                                   onclick="EditItem('@item.Id','@item.Code','@item.Name','@item.AvilableQuantity','@item.Limit','@item.SDS','@item.StorageUnitTypeId','@item.CategoryId','@item.UnitId','@item.SubCategoryId')">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            }
                            @if (canDelete) { <a class="iv-icon-btn danger" data-tip="Delete" onclick="DeleteItem('@item.Id')"><i class="bi bi-trash3-fill"></i></a> }
                        </div>
                    </div>
                }
            </div>

            <!-- ───── Desktop ───── -->
            <div class="iv-table-wrap d-none d-md-block table-responsive">
                <table class="iv-table display nowrap" id="tableUser">
                    <thead>
                        <tr>
                            <th>Barcode</th>
                            <th>Item</th>
                            <th>Category</th>
                            <th>Stock</th>
                            <th>Available</th>
                            <th>Lots</th>
                            <th>SDS</th>
                            <th>Storage</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            var s = Stock(item);
                            var cold = item.StorageUnitType?.TemperatureValue < 0;
                            var activeLots = item.Lots?.Count(x => x.AvilableQuantity > 0 && x.CurrentState > 0) ?? 0;
                            <tr class="@s.Row">
                                <td data-order="@item.Code"><span class="iv-code"><img src="@item.BarcodeImage" alt="" loading="lazy" /><span>@item.Code</span></span></td>
                                <td class="text-start">
                                    @if (canDetails)
                                    {
                                        <a class="iv-name" asp-controller="Items" asp-action="SelectedItem" asp-route-Id="@item.Id">@item.Name</a>
                                    }
                                    else
                                    {
                                        <span class="iv-name">@item.Name</span>
                                    }
                                    <div class="iv-sub">@(item.SubCategory?.Name ?? "")</div>
                                </td>
                                <td><span class="iv-pill teal">@item.Category?.Name</span></td>
                                <td><span class="iv-pill @s.Cls @(s.Cls == "bad" ? "live" : "")">@s.Text</span></td>
                                <td data-order="@item.AvilableQuantity">
                                    <div class="iv-stock">
                                        <b>@item.AvilableQuantity</b> <span class="iv-sub">/ limit @item.Limit</span>
                                        <div class="iv-stock-bar @(s.Cls != "ok" ? "low" : "")"><span style="--w:@(StockPct(item))%"></span></div>
                                    </div>
                                </td>
                                <td data-order="@activeLots"><span class="iv-qty">@activeLots</span></td>
                                <td><span class="iv-pill @(item.SDS == true ? "ok" : "bad")"><i class="bi @(item.SDS == true ? "bi-shield-fill-check" : "bi-shield-x")"></i>@(item.SDS == true ? "Valid" : "Invalid")</span></td>
                                <td><span class="iv-temp @(cold ? "cold" : "room")"><i class="bi bi-thermometer-half"></i>@item.StorageUnitType?.Name</span></td>
                                <td>
                                    <div class="iv-actions-cell">
                                        @if (canCreateLot) { <a class="iv-icon-btn ok" data-tip="Receive lot" asp-controller="Items" asp-action="CreateLot" asp-route-Id="@item.Id"><i class="bi bi-cart-plus-fill"></i></a> }
                                        @if (canExchange)
                                        {
                                            if (item.AvilableQuantity > 0) { <a class="iv-icon-btn cold" data-tip="Exchange" asp-controller="Items" asp-action="ExchangeLot" asp-route-Id="@item.Id"><i class="bi bi-cart-dash-fill"></i></a> }
                                            else { <span class="iv-icon-btn locked" data-tip="Nothing available"><i class="bi bi-cart-dash-fill"></i></span> }
                                        }
                                        @if (canDetails) { <a class="iv-icon-btn" data-tip="Details" asp-controller="Items" asp-action="SelectedItem" asp-route-Id="@item.Id"><i class="bi bi-eye-fill"></i></a> }
                                        @if (canEdit)
                                        {
                                            <a class="iv-icon-btn" data-tip="Edit" data-bs-toggle="modal" data-bs-target="#exampleModal"
                                               onclick="EditItem('@item.Id','@item.Code','@item.Name','@item.AvilableQuantity','@item.Limit','@item.SDS','@item.StorageUnitTypeId','@item.CategoryId','@item.UnitId','@item.SubCategoryId')">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        }
                                        @if (canPrint) { <a class="iv-icon-btn" data-tip="Print label" target="_blank" asp-controller="Items" asp-action="PrintItemBarcode" asp-route-barcodeFile="@item.BarcodeImage" asp-route-Code="@item.Code"><i class="bi bi-printer-fill"></i></a> }
                                        @if (canDelete) { <a class="iv-icon-btn danger" data-tip="Delete" onclick="DeleteItem('@item.Id')"><i class="bi bi-trash3-fill"></i></a> }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<partial name="_SaveItem" />

@section Scripts {
    <script src="~/js/Users.js"></script>
    <script src="~/js/inventory.js" asp-append-version="true"></script>

    @if (!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
    {
        var ok = Context.Session.GetString(Helper.MsgType) == Helper.Success;
        <script>
            Swal.fire({
                title: '@Context.Session.GetString(Helper.Title)',
                text: '@Html.Raw(Context.Session.GetString(Helper.Msg))',
                icon: '@(ok ? "success" : "error")',
                confirmButtonText: 'Ok',
                confirmButtonColor: '#032b42'
            });
        </script>
        Context.Session.SetString(Helper.MsgType, "");
    }

    <script>
        let lbTitleEdit = '@Html.Raw("Edit Item")';
        let lbEdit = '@Html.Raw("Save Changes Only")';
        let lbAddNewRole = '@Html.Raw("Add New Item")';
        let lbbtnSave = '@Html.Raw("Save Data Only")';

        let lbTitleMsgDelete = '@Html.Raw("Delete Item")';
        let lbTextMsgDelete = '@Html.Raw("Are you sure? This deletes the item and everything related to it, including requests and records.")';
        let lbconfirmButtonText = '@Html.Raw("Yes, remove")';
        let lbcancelButtonText = '@Html.Raw("Cancel")';

        let lbTitleDeletedOk = '@Html.Raw("Item deleted")';
        let lbMsgDeletedOkRole = '@Html.Raw("The item has been deleted successfully!")';
        let lbSuccess = '@Html.Raw(Helper.Success)';

        // Quick filters on top of DataTables (falls back to plain row hiding)
        function ivFilter(term) {
            const t = window.jQuery && jQuery.fn.dataTable && jQuery.fn.dataTable.isDataTable('#tableUser')
                ? jQuery('#tableUser').DataTable() : null;
            if (t) { t.search(term, { regex: true, smart: false }).draw(); return; }
            const re = term ? new RegExp(term, 'i') : null;
            document.querySelectorAll('#tableUser tbody tr, .iv-mcards .iv-mcard')
                .forEach(r => r.style.display = !re || re.test(r.textContent) ? '' : 'none');
        }
    </script>
}
