@model ItemViewModel
@{
    string codeGenerate = Guid.NewGuid().ToString("N").Substring(0, 8);
}
@* All element IDs (itemId, itemCode, itemName, itemCategory, itemSubCategory, subCatField, subCatHint,
   itemQnty, itemLimit, itemUnit, itemStorageCondition, sdsYes, sdsNo, itemSDS, title, btnSave)
   are unchanged — Users.js (EditItem/ResetItem) and subcategory-cascade.js keep working. *@

<div class="modal fade iv-modal" id="exampleModal" tabindex="-1" aria-hidden="true" dir="ltr">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-box-seam"></i> <span id="title">Add New Item</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" class="iv-form">
                <div class="modal-body">
                    <input hidden asp-for="NewItem.Id" id="itemId" value="0" />

                    <div class="row g-3">
                        <!-- Identity -->
                        <div class="col-md-5 iv-field">
                            <label>Item code</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white" style="border-radius:12px 0 0 12px;border:1.5px solid var(--iv-line);border-right:0"><i class="bi bi-upc"></i></span>
                                <input id="itemCode" required asp-for="NewItem.Code" value="@codeGenerate" class="form-control" style="border-radius:0;font-family:ui-monospace,Consolas,monospace;letter-spacing:1px" />
                                <button type="button" class="iv-btn iv-btn-ghost" style="border-radius:0 12px 12px 0" title="Generate new code"
                                        onclick="document.getElementById('itemCode').value=([...crypto.getRandomValues(new Uint8Array(4))].map(b=>b.toString(16).padStart(2,'0')).join(''))">
                                    <i class="bi bi-arrow-repeat"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewItem.Code" class="text-danger small"></span>
                        </div>
                        <div class="col-md-7 iv-field">
                            <label>Item name</label>
                            <input id="itemName" required asp-for="NewItem.Name" class="form-control" placeholder="e.g. Ethanol 96%" autofocus />
                            <span asp-validation-for="NewItem.Name" class="text-danger small"></span>
                        </div>

                        <!-- Classification -->
                        <div class="col-md-6 iv-field">
                            <label>Category</label>
                            <select id="itemCategory" required class="form-select" asp-items="Model.ListCategories" asp-for="NewItem.CategoryId">
                                <option value="" selected disabled>Choose category</option>
                            </select>
                            <span asp-validation-for="NewItem.CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 iv-field subcat-field" id="subCatField" data-state="idle">
                            <label>Sub category</label>
                            <select id="itemSubCategory" class="form-select" asp-for="NewItem.SubCategoryId">
                                <option value="">Choose category first</option>
                            </select>
                            <div id="subCatHint" class="subcat-hint"></div>
                            <span asp-validation-for="NewItem.SubCategoryId" class="text-danger small"></span>
                        </div>

                        <!-- Stock rules -->
                        <div class="col-md-4 iv-field">
                            <label>Reorder limit</label>
                            <div class="iv-stepper-num">
                                <button type="button" data-step="-1">−</button>
                                <input id="itemLimit" value="1" required asp-for="NewItem.Limit" class="form-control" type="number" min="0" />
                                <button type="button" data-step="1">+</button>
                            </div>
                            <span asp-validation-for="NewItem.Limit" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 iv-field">
                            <label>Unit</label>
                            <select id="itemUnit" class="form-select" required asp-items="Model.ListUnits" asp-for="NewItem.UnitId">
                                <option value="" selected disabled>Choose unit</option>
                            </select>
                            <span asp-validation-for="NewItem.UnitId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 iv-field">
                            <label>Storage condition</label>
                            <select id="itemStorageCondition" class="form-select" required asp-items="Model.ListStorageUnitTypes" asp-for="NewItem.StorageUnitTypeId"></select>
                            <span asp-validation-for="NewItem.StorageUnitTypeId" class="text-danger small"></span>
                        </div>

                        <!-- hidden: quantity is driven by lots, never typed -->
                        <input id="itemQnty" value="0" asp-for="NewItem.AvilableQuantity" type="hidden" />

                        <!-- SDS -->
                        <div class="col-12 iv-field">
                            <label>Safety Data Sheet (SDS)</label>
                            <div class="iv-seg">
                                <input type="radio" name="radio-card" id="sdsYes" data-seg-target="#itemSDS" data-seg-value="True" />
                                <label for="sdsYes" class="yes" onclick="document.getElementById('itemSDS').value='True'"><i class="bi bi-shield-fill-check"></i> Valid</label>
                                <input type="radio" name="radio-card" id="sdsNo" data-seg-target="#itemSDS" data-seg-value="False" />
                                <label for="sdsNo" class="no" onclick="document.getElementById('itemSDS').value='False'"><i class="bi bi-shield-x"></i> Invalid</label>
                            </div>
                            <input id="itemSDS" required hidden asp-for="NewItem.SDS" />
                            <span asp-validation-for="NewItem.SDS" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="iv-btn iv-btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="iv-btn iv-btn-gold" title="Save and print the item label" asp-controller="Items" asp-action="SaveAndPrint">
                        <i class="bi bi-printer-fill"></i> Save & print label
                    </button>
                    <input type="submit" class="iv-btn iv-btn-primary" value="Save changes" id="btnSave" asp-action="Save" asp-controller="Items" />
                </div>
            </form>
        </div>
    </div>
</div>
<link rel="stylesheet" href="~/css/subcategory-cascade.css" asp-append-version="true" />
<script src="~/js/subcategory-cascade.js" asp-append-version="true"></script>
