@model LotViewModel
@* Edit Lot modal — all element IDs kept identical so the existing edit JS keeps working *@

<div class="modal fade iv-modal" id="EditLotModal" tabindex="-1" aria-hidden="true" dir="ltr">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square"></i> <span id="title">Edit Lot</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="Save" asp-controller="Lots" method="post" class="iv-form">
                <div class="modal-body">
                    <input hidden asp-for="NewLot.Id" id="editLotId" value="0" />

                    <div class="row g-3">
                        <div class="col-md-5">
                            <div class="iv-barcode-big">
                                <img src="~/lotbarcodes/184799d5.png" alt="Lot barcode" />
                                <b id="editLotBarcodeText"></b>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="row g-2">
                                <div class="col-12 iv-field">
                                    <label>Lot number</label>
                                    <input id="editLotNum" asp-for="NewLot.LotNumber" readonly required class="form-control" />
                                </div>
                                <div class="col-6 iv-field">
                                    <label>Quantity</label>
                                    <input readonly id="editLotQty" asp-for="NewLot.TotalQuantity" class="form-control" type="number" min="0" />
                                </div>
                                <div class="col-6 iv-field">
                                    <label>Expiry date</label>
                                    <input readonly type="text" id="editLotExpiryDate" asp-for="NewLot.ExpiryDate" class="form-control" />
                                </div>
                                <div class="col-6 iv-field">
                                    <label>Manufacture date</label>
                                    <input readonly type="text" id="editLotManf" asp-for="NewLot.ManufactureDate" class="form-control" />
                                </div>
                                <div class="col-6 iv-field">
                                    <label>Received date</label>
                                    <input readonly type="text" id="editLotReci" asp-for="NewLot.ReceivedDate" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Storage location -->
                    <div class="iv-panel mt-2">
                        <div class="iv-panel-head teal">
                            <div class="ph-icon"><i class="bi bi-geo-alt-fill"></i></div>
                            <div><h5>Storage location</h5><small>Room → Unit → Shelf → Box → Slot</small></div>
                        </div>
                        <div class="iv-panel-body">
                            <div class="row g-2">
                                <div class="col-md-3 col-6">
                                    <select id="editSelRoom" class="form-select">
                                        <option value="" selected disabled>Room</option>
                                        @foreach (var r in Model.ListRooms)
                                        {
                                            <option value="@r.Value">@r.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 col-6"><select id="editSelUnit" class="form-select" disabled><option value="" selected disabled>Unit</option></select></div>
                                <div class="col-md-3 col-6"><select id="editSelShelf" class="form-select" disabled><option value="" selected disabled>Shelf</option></select></div>
                                <div class="col-md-3 col-6"><select id="editSelBox" class="form-select" disabled><option value="" selected disabled>Box</option></select></div>
                            </div>

                            <div id="editGridWrapper" class="mt-3 text-center" style="display:none;">
                                <div class="iv-grid-legend">
                                    <span><span class="legend-box legend-free"></span>Available</span>
                                    <span><span class="legend-box legend-occupied"></span>Occupied</span>
                                    <span><span class="legend-box legend-selected"></span>Selected</span>
                                </div>
                                <div class="table-responsive d-inline-block mx-auto">
                                    <table id="editBoxGridTable" class="mb-0" style="width:auto;border-collapse:separate;border-spacing:4px"></table>
                                </div>
                                <div class="iv-slot-label" id="editSelectedSlotLabel">No slot selected yet</div>
                            </div>

                            <input type="hidden" asp-for="NewLot.Id" id="editCurrentLotId" />
                            <input type="hidden" asp-for="NewLot.BoxId" id="editHiddenBoxId" />
                            <input type="hidden" asp-for="NewLot.RowIndex" id="editHiddenRowIndex" />
                            <input type="hidden" asp-for="NewLot.ColumnIndex" id="editHiddenColumnIndex" />

                            <!-- current location — used for pre-selection when the modal opens -->
                            <input type="hidden" id="editCurrentRoomId" value="@Model.NewLot?.Box?.Shelf?.StorageUnit?.RoomId" />
                            <input type="hidden" id="editCurrentUnitId" value="@Model.NewLot?.Box?.Shelf?.StorageUnitId" />
                            <input type="hidden" id="editCurrentShelfId" value="@Model.NewLot?.Box?.ShelfId" />
                            <input type="hidden" id="editCurrentBoxId" value="@Model.NewLot?.BoxId" />
                            <span asp-validation-for="NewLot.BoxId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- SDS -->
                    <div class="iv-field mt-3">
                        <label>Lot SDS</label>
                        <div class="iv-seg">
                            <input type="radio" name="edit-radio-card" id="editSdsYes" data-seg-target="#editLotSDS" data-seg-value="True" />
                            <label for="editSdsYes" class="yes" onclick="document.getElementById('editLotSDS').value='True'"><i class="bi bi-shield-fill-check"></i> Valid</label>
                            <input type="radio" name="edit-radio-card" id="editSdsNo" data-seg-target="#editLotSDS" data-seg-value="False" />
                            <label for="editSdsNo" class="no" onclick="document.getElementById('editLotSDS').value='False'"><i class="bi bi-shield-x"></i> Invalid</label>
                        </div>
                        <input id="editLotSDS" required hidden asp-for="NewLot.SDS" />
                        <span asp-validation-for="NewLot.SDS" class="text-danger small"></span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="iv-btn iv-btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="iv-btn iv-btn-primary" id="editBtnSave" asp-action="Save" asp-controller="Lots"><i class="bi bi-check2-circle"></i> Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
