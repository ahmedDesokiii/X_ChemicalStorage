@model ItemViewModel
@{
    ViewData["Title"] = "Receive Lot";
    var item = Model.NewItem;
    string lotNumGenerate = Guid.NewGuid().ToString("N").Substring(0, 8).ToUpper();
    var cold = item?.StorageUnitType?.TemperatureValue < 0;
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}
<link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />
<style>
    /* live label preview */
    .iv-label-preview { position: sticky; top: 20px; }
    .iv-sticker {
        width: 100%; aspect-ratio: 5 / 3; background: #fff; border-radius: 10px; padding: 14px 16px; color: #000;
        display: grid; grid-template-rows: auto 1fr auto; box-shadow: 0 20px 40px rgba(3,43,66,.25), 0 0 0 1px var(--iv-line);
        position: relative; overflow: hidden; transform: rotate(-1.5deg); transition: transform .4s var(--iv-ease);
    }
    .iv-sticker:hover { transform: rotate(0) scale(1.02); }
    .iv-sticker::before { content: ''; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 40%, rgba(197,165,71,.15) 50%, transparent 60%); background-size: 250% 100%; animation: stkSheen 4s infinite; }
    @@keyframes stkSheen { to { background-position: -150% 0; } }
    .stk-top { display: flex; justify-content: space-between; gap: 8px; font-weight: 800; font-size: .95rem; line-height: 1.15; }
    .stk-temp { border: 1.5px solid #000; border-radius: 4px; padding: 0 6px; font-size: .68rem; white-space: nowrap; height: fit-content; }
    .stk-temp.cold { background: #000; color: #fff; }
    .stk-code { display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .stk-bars { height: 46px; width: 85%; background: repeating-linear-gradient(90deg, #000 0 2px, transparent 2px 4px, #000 4px 5px, transparent 5px 8px, #000 8px 11px, transparent 11px 12px); }
    .stk-code span { font-family: ui-monospace, Consolas, monospace; font-weight: 700; letter-spacing: 1.5px; font-size: .85rem; }
    .stk-bottom { display: flex; justify-content: space-between; align-items: flex-end; font-size: .7rem; }
    .stk-exp { border: 2px solid #000; border-radius: 5px; padding: 1px 8px; text-align: center; line-height: 1.05; }
    .stk-exp small { display: block; font-size: .55rem; font-weight: 800; letter-spacing: 1px; }
    .stk-exp b { font-size: .95rem; }
    .iv-flash { animation: ivFlash .6s var(--iv-ease); }
    @@keyframes ivFlash { 0% { background: var(--iv-gold-soft); } }
    .iv-shelf-life { font-size: .78rem; font-weight: 700; margin-top: 6px; }
    .iv-shelf-life.ok { color: var(--iv-ok); } .iv-shelf-life.warn { color: #a26e00; } .iv-shelf-life.bad { color: var(--iv-bad); }
</style>

<!-- ═════════ HERO ═════════ -->
<div class="iv-hero" dir="ltr">
    <div class="iv-hero-orb"></div>
    <div class="container-fluid">
        <nav class="iv-crumbs">
            <a asp-controller="Items" asp-action="Index"><i class="bi bi-boxes"></i> Items</a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Items" asp-action="SelectedItem" asp-route-id="@item?.Id">@item?.Name</a>
            <i class="bi bi-chevron-right"></i>
            <span>Receive lot</span>
        </nav>
        <div class="iv-hero-row">
            <div class="iv-hero-id">
                <div class="iv-hero-icon"><i class="bi bi-cart-plus-fill"></i></div>
                <div>
                    <h1 class="iv-hero-title">Receive Lot</h1>
                    <p class="iv-hero-sub">@item?.Name · <span style="font-family:ui-monospace,Consolas,monospace">@item?.Code</span></p>
                </div>
            </div>
            <div class="iv-hero-chips">
                <div class="iv-hero-chip"><b>@item?.AvilableQuantity</b><small>In stock</small></div>
                <div class="iv-hero-chip gold"><b>@(Model.LotsList?.Count(l => l.AvilableQuantity > 0) ?? 0)</b><small>Active lots</small></div>
            </div>
        </div>
    </div>
</div>

<form method="post" id="lotForm" class="iv-form" dir="ltr" novalidate>
    <div class="container-fluid pb-4">
        <input hidden asp-for="NewLot.ItemId" value="@item?.Id" />

        <div class="row g-4">
            <!-- ═════════ LEFT: data + location ═════════ -->
            <div class="col-xl-8">
                <div class="iv-panel">
                    <div class="iv-panel-head gold">
                        <div class="ph-icon"><i class="bi bi-receipt"></i></div>
                        <div><h5>Lot data</h5><small>As printed on the supplier's packaging</small></div>
                    </div>
                    <div class="iv-panel-body">
                        <div class="row g-3">
                            <div class="col-md-6 iv-field">
                                <label>Lot number</label>
                                <div class="iv-input-icon">
                                    <i class="bi bi-hash"></i>
                                    <input id="lotNum" required asp-for="NewLot.LotNumber" value="@lotNumGenerate" class="form-control" style="font-family:ui-monospace,Consolas,monospace;letter-spacing:1px" />
                                </div>
                                <small class="iv-sub">Auto-generated — overwrite with the supplier lot if needed.</small>
                            </div>
                            <div class="col-md-6 iv-field">
                                <label>Quantity received @(item?.Unit?.Name is string u ? $"({u})" : "")</label>
                                <div class="iv-stepper-num">
                                    <button type="button" data-step="-1">−</button>
                                    <input id="lotQnty" value="1" asp-for="NewLot.TotalQuantity" required class="form-control" type="number" min="1" autofocus />
                                    <button type="button" data-step="1">+</button>
                                </div>
                                <span asp-validation-for="NewLot.TotalQuantity" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 iv-field">
                                <label>Manufacture date</label>
                                <input type="date" id="lotManufactureDate" asp-for="NewLot.ManufactureDate" value="@today" max="@today" class="form-control" />
                                <span asp-validation-for="NewLot.ManufactureDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 iv-field">
                                <label>Expiry date</label>
                                <input type="date" id="lotExpiryDate" asp-for="NewLot.ExpiryDate" value="" required class="form-control" />
                                <div id="shelfLife" class="iv-shelf-life"></div>
                                <span asp-validation-for="NewLot.ExpiryDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 iv-field">
                                <label>Supplier</label>
                                <select id="lotSupp" class="form-select" required asp-items="Model.ListSuppliers">
                                    <option selected disabled value="">Choose supplier</option>
                                </select>
                            </div>
                            <div class="col-12 iv-field">
                                <label>Lot SDS</label>
                                <div class="iv-seg">
                                    <input type="radio" name="radio-card" id="sdsYes" data-seg-target="#itemSDS" data-seg-value="True" />
                                    <label for="sdsYes" class="yes" onclick="document.getElementById('itemSDS').value='True'"><i class="bi bi-shield-fill-check"></i> Valid SDS received</label>
                                    <input type="radio" name="radio-card" id="sdsNo" data-seg-target="#itemSDS" data-seg-value="False" />
                                    <label for="sdsNo" class="no" onclick="document.getElementById('itemSDS').value='False'"><i class="bi bi-shield-x"></i> Missing / invalid</label>
                                </div>
                                <input id="itemSDS" required hidden asp-for="NewLot.SDS" />
                                <span asp-validation-for="NewLot.SDS" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="iv-panel">
                    <div class="iv-panel-head teal">
                        <div class="ph-icon"><i class="bi bi-geo-alt-fill"></i></div>
                        <div><h5>Storage location</h5><small>Only Lots-inventory units are listed</small></div>
                        <div class="ph-end"><span class="iv-temp @(cold ? "cold" : "room")"><i class="bi bi-thermometer-half"></i>Needs @item?.StorageUnitType?.Name</span></div>
                    </div>
                    <div class="iv-panel-body">
                        <div class="row g-2">
                            <div class="col-md-3 col-6">
                                <select id="selRoom" class="form-select">
                                    <option value="">Room</option>
                                    @foreach (var r in Model.ListRooms) { <option value="@r.Value">@r.Text</option> }
                                </select>
                            </div>
                            <div class="col-md-3 col-6"><select id="selUnit" class="form-select" disabled><option value="">Storage unit</option></select></div>
                            <div class="col-md-3 col-6"><select id="selShelf" class="form-select" disabled><option value="">Shelf</option></select></div>
                            <div class="col-md-3 col-6"><select id="selBox" class="form-select" disabled><option value="">Box</option></select></div>
                        </div>

                        <div id="gridWrapper" class="text-center mt-3" hidden>
                            <div class="iv-grid-legend">
                                <span><i class="free"></i>Free</span><span><i class="lot"></i>Lot</span>
                                <span><i class="sample"></i>Temp sample</span><span><i class="sel"></i>Selected</span>
                            </div>
                            <div class="iv-grid" id="boxGrid"></div>
                            <div class="iv-slot-label" id="selectedSlotLabel">Pick a free slot</div>
                        </div>

                        <input type="hidden" asp-for="NewLot.BoxId" id="hiddenBoxId" />
                        <input type="hidden" asp-for="NewLot.RowIndex" id="hiddenRowIndex" />
                        <input type="hidden" asp-for="NewLot.ColumnIndex" id="hiddenColumnIndex" />
                        <span asp-validation-for="NewLot.BoxId" class="text-danger small"></span>
                    </div>
                    <div class="iv-actionbar">
                        <a asp-controller="Items" asp-action="Index" class="iv-btn iv-btn-ghost">Cancel</a>
                        <button type="submit" class="iv-btn iv-btn-primary" asp-controller="Lots" asp-action="Save" id="btnSave">
                            <i class="bi bi-check2-circle"></i> Save lot
                        </button>
                        <button type="submit" class="iv-btn iv-btn-gold" asp-controller="Lots" asp-action="SaveAndPrint" id="btnSavePrint">
                            <i class="bi bi-printer-fill"></i> Save & print label
                        </button>
                    </div>
                </div>
            </div>

            <!-- ═════════ RIGHT: item + live label ═════════ -->
            <div class="col-xl-4">
                <div class="iv-label-preview">
                    <div class="iv-panel">
                        <div class="iv-panel-head">
                            <div class="ph-icon"><i class="bi bi-box-seam"></i></div>
                            <div><h5>@item?.Name</h5><small>@item?.Category?.Name</small></div>
                        </div>
                        <div class="iv-panel-body">
                            <div class="d-flex align-items-center gap-3">
                                <span class="iv-code"><img src="@item?.BarcodeImage" alt="" /><span>@item?.Code</span></span>
                                <div class="d-flex flex-column gap-1">
                                    <span class="iv-temp @(cold ? "cold" : "room")"><i class="bi bi-thermometer-half"></i>@item?.StorageUnitType?.Name</span>
                                    <span class="iv-pill @(item?.SDS == true ? "ok" : "bad")">Item SDS @(item?.SDS == true ? "valid" : "invalid")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="iv-panel">
                        <div class="iv-panel-head gold">
                            <div class="ph-icon"><i class="bi bi-tag-fill"></i></div>
                            <div><h5>Label preview</h5><small>Updates as you type</small></div>
                        </div>
                        <div class="iv-panel-body" style="background:repeating-linear-gradient(45deg,#f6f9fb 0 10px,#eef3f7 10px 20px)">
                            <div class="iv-sticker">
                                <div class="stk-top">
                                    <span>@item?.Name</span>
                                    <span class="stk-temp @(cold ? "cold" : "")">@(cold ? "❄ " : "")@item?.StorageUnitType?.Name</span>
                                </div>
                                <div class="stk-code"><div class="stk-bars"></div><span id="pvLot">@lotNumGenerate</span></div>
                                <div class="stk-bottom">
                                    <div><div>Qty: <b id="pvQty">1</b></div><div id="pvLoc" class="text-truncate" style="max-width:150px">—</div></div>
                                    <div class="stk-exp"><small>EXP</small><b id="pvExp">—</b></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/inventory.js" asp-append-version="true"></script>
    <script>
        (() => {
            const $ = id => document.getElementById(id);
            const flash = el => { el.classList.remove('iv-flash'); void el.offsetWidth; el.classList.add('iv-flash'); };
            const fmt = v => v ? new Date(v).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: '2-digit' }) : '—';

            // focus quantity
            window.addEventListener('load', () => setTimeout(() => { $('lotQnty').focus(); $('lotQnty').select(); }, 100));

            // live label
            $('lotNum').addEventListener('input', e => { $('pvLot').textContent = e.target.value || '—'; flash($('pvLot')); });
            $('lotQnty').addEventListener('input', e => { $('pvQty').textContent = e.target.value || '0'; flash($('pvQty')); });

            // shelf-life hint
            function shelfLife() {
                const m = $('lotManufactureDate').value, x = $('lotExpiryDate').value, el = $('shelfLife');
                $('pvExp').textContent = fmt(x); flash($('pvExp'));
                if (!x) { el.textContent = ''; return; }
                const left = Math.round((new Date(x) - new Date().setHours(0, 0, 0, 0)) / 864e5);
                const life = m ? Math.round((new Date(x) - new Date(m)) / 864e5) : null;
                if (m && new Date(x) <= new Date(m)) { el.className = 'iv-shelf-life bad'; el.innerHTML = '<i class="bi bi-x-octagon-fill"></i> Expiry must be after manufacture'; return; }
                el.className = 'iv-shelf-life ' + (left <= 0 ? 'bad' : left <= 30 ? 'warn' : 'ok');
                el.innerHTML = left <= 0 ? '<i class="bi bi-x-octagon-fill"></i> Already expired'
                    : `<i class="bi bi-hourglass-split"></i> ${left} days left` + (life ? ` · shelf life ${life} days` : '');
            }
            $('lotExpiryDate').addEventListener('change', shelfLife);
            $('lotManufactureDate').addEventListener('change', shelfLife);

            // location picker (Lots inventory zone only — server default)
            IV.slotPicker({
                room: '#selRoom', unit: '#selUnit', shelf: '#selShelf', box: '#selBox',
                grid: '#boxGrid', wrap: '#gridWrapper', label: '#selectedSlotLabel',
                hiddenBox: '#hiddenBoxId', hiddenRow: '#hiddenRowIndex', hiddenCol: '#hiddenColumnIndex',
                onChange: path => { $('pvLoc').textContent = path ? path.split(' › ').slice(-2).join(' › ') : '—'; flash($('pvLoc')); }
            });

            // validation before submit
            document.getElementById('lotForm').addEventListener('submit', e => {
                const problems = [];
                const req = [['lotNum', 'Lot number'], ['lotQnty', 'Quantity'], ['lotExpiryDate', 'Expiry date'], ['lotSupp', 'Supplier']];
                req.forEach(([id, name]) => { const el = $(id); const bad = !el.value; el.classList.toggle('is-invalid', bad); if (bad) problems.push(name); });
                if (!$('itemSDS').value) problems.push('SDS status');
                if ($('lotManufactureDate').value && $('lotExpiryDate').value && $('lotExpiryDate').value <= $('lotManufactureDate').value) problems.push('Expiry after manufacture');
                if (!$('hiddenBoxId').value || !$('hiddenRowIndex').value) problems.push('Storage slot');

                if (problems.length) {
                    e.preventDefault();
                    Swal.fire({ icon: 'warning', title: 'Almost there', html: 'Please complete:<br><b>' + problems.join('<br>') + '</b>', confirmButtonColor: '#032b42' });
                    return;
                }
                const btn = e.submitter;
                if (btn) { btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving…'; setTimeout(() => btn.disabled = true, 0); }
            });
        })();
    </script>
}
