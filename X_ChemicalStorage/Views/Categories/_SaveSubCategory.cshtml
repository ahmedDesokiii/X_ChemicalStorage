@model CategoryViewModel

<!-- SubCategory Modal -->
<div class="modal fade" id="subCategoryModal" tabindex="-1" aria-labelledby="subCategoryTitle" aria-hidden="true" dir="ltr">
    <div class="modal-dialog card card-success card-outline">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#758A93" dir="ltr">
                <span class="fs-4 fw-bold modal-title" id="subCategoryTitle"></span>
                <a href="#" class="btn-close position-absolute end-0 mx-3" data-bs-dismiss="modal" aria-label="Close"></a>
            </div>
            <div class="modal-body">
                <form asp-action="Save" asp-controller="SubCategories" method="post">
                    <input type="hidden" asp-for="NewSubCategory.Id" id="subCatId" value="0" />
                    <!-- Parent category is sent as a hidden value; the user only sees its name -->
                    <input type="hidden" asp-for="NewSubCategory.CategoryId" id="subCatCategoryId" />

                    <!-- Parent Category (read-only chip) -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4">&nbsp;&nbsp;&nbsp;&nbsp; Category</span>
                        <input type="text" id="subCatCategoryName" class="form-control text-center subcat-parent-chip" readonly tabindex="-1" />
                    </div>
                    <span asp-validation-for="NewSubCategory.CategoryId" class="text-danger"></span>

                    <!-- SubCategory Name -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4">&nbsp;&nbsp;&nbsp;&nbsp; SubCategory Name</span>
                        <input id="subCatName" required asp-for="NewSubCategory.Name" class="form-control text-center"
                               autocomplete="off" aria-required="true" placeholder="Enter SubCategory Name ..." type="text"
                               style="border-top-right-radius:20px;">
                    </div>
                    <span asp-validation-for="NewSubCategory.Name" class="text-danger"></span>

                    <!-- SubCategory Details -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4">&nbsp;&nbsp;&nbsp;&nbsp; Details</span>
                        <input id="subCatDetails" asp-for="NewSubCategory.Details" class="form-control text-center"
                               autocomplete="off" placeholder="Enter Details ..." type="text"
                               style="border-top-right-radius:20px;">
                    </div>
                    <span asp-validation-for="NewSubCategory.Details" class="text-danger"></span>

                    <div class="modal-footer mx-auto justify-content-center my-2">
                        <button type="submit" class="btn btn-success">Save</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Event delegation + data-attributes => no inline onclick, no quoting bugs with names containing ' or "
    document.addEventListener('click', function (e) {
        const add = e.target.closest('[data-subcat-add]');
        const edit = e.target.closest('[data-subcat-edit]');
        const del = e.target.closest('[data-subcat-delete]');

        if (add) {
            setSubCat('Add SubCategory', 0, '', '', add.dataset.catId, add.dataset.catName);
        } else if (edit) {
            setSubCat('Edit SubCategory', edit.dataset.id, edit.dataset.name, edit.dataset.details, edit.dataset.catId, edit.dataset.catName);
        } else if (del) {
            e.preventDefault();
            const id = del.dataset.id;
            Swal.fire({
                title: 'Are you sure?',
                text: 'Deleting a SubCategory that still has Items assigned to it will be blocked automatically.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it'
            }).then(function (r) {
                if (r.isConfirmed) window.location.href = '/SubCategories/Delete?Id=' + encodeURIComponent(id);
            });
        }
    });

    function setSubCat(title, id, name, details, catId, catName) {
        document.getElementById('subCategoryTitle').innerText = title;
        document.getElementById('subCatId').value = id;
        document.getElementById('subCatName').value = name || '';
        document.getElementById('subCatDetails').value = details || '';
        document.getElementById('subCatCategoryId').value = catId;
        document.getElementById('subCatCategoryName').value = catName || '';
    }
</script>
