@model LotViewModel
@{
    ViewData["Title"] = "Lots";

    var today = DateTime.Today;
    (string Row, string Pill, string Text, int? Days) Exp(DateTime? d)
    {
        if (d == null) return ("", "muted", "No expiry", null);
        var days = (d.Value.Date - today).Days;
        if (days <= 0) return ("row-bad", "bad", "Expired", days);
        if (days <= 30) return ("row-warn", "warn", "Near expiry", days);
        return ("row-ok", "ok", "Valid", days);
    }
    string DaysText(int? d) => d == null ? "—" : d <= 0 ? $"{-d}d ago" : d == 1 ? "tomorrow" : $"in {d}d";

    var total = Model.LotsList.Count;
    var active = Model.LotsList.Count(l => l.AvilableQuantity > 0);
    var nearExp = Model.LotsList.Count(l => l.ExpiryDate != null && (l.ExpiryDate.Value.Date - today).Days is > 0 and <= 30);
    var expired = Model.ExpiryLotsList.Count;
    int i = 0;
}
<link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />

<!-- ═════════ HERO ═════════ -->
<div class="iv-hero" dir="ltr">
    <div class="iv-hero-orb"></div>
    <div class="container-fluid">
        <div class="iv-hero-row">
            <div class="iv-hero-id">
                <div class="iv-hero-icon"><i class="bi bi-archive-fill"></i></div>
                <div>
                    <h1 class="iv-hero-title">Lots</h1>
                    <p class="iv-hero-sub">Receive, track expiry, exchange and locate every lot in storage.</p>
                </div>
            </div>
            <div class="iv-hero-chips">
                <div class="iv-hero-chip"><b data-count="@total">0</b><small>Total</small></div>
                <div class="iv-hero-chip gold" style="animation-delay:.06s"><b data-count="@active">0</b><small>In stock</small></div>
                <div class="iv-hero-chip warn" style="animation-delay:.12s"><b data-count="@nearExp">0</b><small>≤ 30 days</small></div>
                <div class="iv-hero-chip bad" style="animation-delay:.18s"><b data-count="@expired">0</b><small>Expired</small></div>
            </div>
        </div>
    </div>
</div>

<section class="container-fluid pb-4" dir="ltr">
    <!-- ═════════ ACTION TILES ═════════ -->
    <div class="iv-tiles">
        @if (Model.CanCreateLot)
        {
            <a class="iv-tile ok" data-bs-toggle="modal" data-bs-target="#ListItemsModalCreate" onclick="typeof setMode==='function' && setMode('receiving')">
                <i class="bi bi-cart-plus-fill"></i>
                <span>Receive Lot<small>Scan an item to create a lot</small></span>
            </a>
        }
        @if (Model.CanExchangeLot)
        {
            <a class="iv-tile navy" data-bs-toggle="modal" data-bs-target="#ListItemsModalExchange">
                <i class="bi bi-cart-dash-fill"></i>
                <span>Exchange Lot<small>Dispense by FEFO</small></span>
            </a>
        }
        @if (Model.CanViewExpiryLots)
        {
            <a class="iv-tile bad" data-bs-toggle="modal" data-bs-target="#ExpieryLotsModal">
                <i class="bi bi-calendar-x-fill"></i>
                <span>Expired Lots<small>Review & dispose</small></span>
                @if (expired > 0) { <em class="iv-tile-count">@expired</em> }
            </a>
        }
        <a class="iv-tile gold" asp-controller="Rooms" asp-action="Index">
            <i class="bi bi-building"></i>
            <span>Storage Map<small>Rooms, units & boxes</small></span>
        </a>
    </div>

    <!-- ═════════ LIST ═════════ -->
    <div class="iv-panel">
        <div class="iv-panel-head">
            <div class="ph-icon"><i class="bi bi-list-ul"></i></div>
            <div><h5>All Lots</h5><small>Sorted by expiry — first to expire on top</small></div>
            <div class="ph-end">
                <span class="iv-pill ok"><i class="bi bi-check-circle-fill"></i> Valid</span>
                <span class="iv-pill warn"><i class="bi bi-hourglass-split"></i> ≤ 30d</span>
                <span class="iv-pill bad"><i class="bi bi-x-octagon-fill"></i> Expired</span>
            </div>
        </div>

        @if (!Model.LotsList.Any())
        {
            <div class="iv-empty">
                <i class="bi bi-inboxes"></i>
                <h5>No lots yet</h5>
                <p>Receive your first lot to start tracking stock and expiry.</p>
                @if (Model.CanCreateLot)
                {
                    <button class="iv-btn iv-btn-gold" data-bs-toggle="modal" data-bs-target="#ListItemsModalCreate"><i class="bi bi-cart-plus-fill"></i> Receive Lot</button>
                }
            </div>
        }
        else
        {
            <!-- ───── Mobile ───── -->
            <div class="iv-mcards d-md-none">
                @foreach (var lot in Model.LotsList)
                {
                    var e = Exp(lot.ExpiryDate);
                    var cold = lot.Item?.StorageUnitType?.TemperatureValue < 0;
                    <div class="iv-mcard @e.Row" style="animation-delay:@(Math.Min(i++, 10) * 40)ms">
                        <div class="iv-mcard-head">
                            <h6>@lot.Item?.Name</h6>
                            <span class="iv-code"><img src="@lot.BarcodeImage" alt="" /><span>@lot.LotNumber</span></span>
                        </div>
                        <div class="iv-mcard-body">
                            <div><label>Status</label><span class="iv-pill @e.Pill @(e.Pill == "bad" ? "live" : "")">@e.Text</span></div>
                            <div><label>Expiry</label><b>@lot.ExpiryDate?.ToString("dd MMM yyyy")</b><small class="iv-sub">@DaysText(e.Days)</small></div>
                            <div><label>Available</label><span class="iv-qty @(lot.AvilableQuantity <= 0 ? "zero" : "")">@lot.AvilableQuantity</span></div>
                            <div><label>SDS</label><span class="iv-pill @(lot.SDS == true ? "ok" : "bad")">@(lot.SDS == true ? "Valid" : "Invalid")</span></div>
                            <div style="grid-column:1/-1"><label>Location</label><span><i class="bi bi-geo-alt text-muted"></i> @(lot.ShortLocation ?? "—")</span></div>
                            <div style="grid-column:1/-1"><label>Storage</label><span class="iv-temp @(cold ? "cold" : "room")"><i class="bi bi-thermometer-half"></i>@lot.Item?.StorageUnitType?.Name</span></div>
                        </div>
                        <div class="iv-mcard-foot">
                            @if (Model.CanViewDetails)
                            {
                                <a class="iv-icon-btn" data-tip="Details" asp-controller="Lots" asp-action="SelectedLot" asp-route-Id="@lot.Id"><i class="bi bi-eye-fill"></i></a>
                            }
                            @if (Model.CanPrintBarcode)
                            {
                                <a class="iv-icon-btn" data-tip="Print label" target="_blank" asp-controller="Lots" asp-action="PrintLot" asp-route-id="@lot.Id"><i class="bi bi-printer-fill"></i></a>
                            }
                            @if (Model.CanEditLot)
                            {
                                <span class="iv-icon-btn locked" data-tip="Lots are immutable"><i class="bi bi-pencil-square"></i></span>
                            }
                            @if (Model.CanDeleteLot)
                            {
                                <a class="iv-icon-btn danger" data-tip="Delete" onclick="DeleteLot('@lot.Id')"><i class="bi bi-trash3-fill"></i></a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- ───── Desktop ───── -->
            <div class="iv-table-wrap d-none d-md-block table-responsive">
                <table class="iv-table display nowrap" id="tableUser">
                    <thead>
                        <tr>
                            <th>Lot</th>
                            <th>Item</th>
                            <th>Status</th>
                            <th>Expiry</th>
                            <th>Available</th>
                            <th>Location</th>
                            <th>SDS</th>
                            <th>Received</th>
                            <th>Storage</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lot in Model.LotsList)
                        {
                            var e = Exp(lot.ExpiryDate);
                            var cold = lot.Item?.StorageUnitType?.TemperatureValue < 0;
                            <tr class="@e.Row">
                                <td data-order="@lot.LotNumber">
                                    <span class="iv-code"><img src="@lot.BarcodeImage" alt="" loading="lazy" /><span>@lot.LotNumber</span></span>
                                </td>
                                <td class="text-start">
                                    @if (Model.CanViewItemDetails)
                                    {
                                        <a class="iv-name" asp-controller="Items" asp-action="SelectedItem" asp-route-Id="@lot.ItemId">@lot.Item?.Name</a>
                                    }
                                    else
                                    {
                                        <span class="iv-name">@lot.Item?.Name</span>
                                    }
                                    <div class="iv-sub">@lot.Item?.Code</div>
                                </td>
                                <td data-order="@(e.Days ?? 99999)"><span class="iv-pill @e.Pill @(e.Pill == "bad" ? "live" : "")">@e.Text</span></td>
                                <td data-order="@lot.ExpiryDate?.ToString("yyyyMMdd")">
                                    <div class="iv-exp @e.Pill"><b>@lot.ExpiryDate?.ToString("dd MMM yyyy")</b><small>@DaysText(e.Days)</small></div>
                                </td>
                                <td data-order="@lot.AvilableQuantity"><span class="iv-qty @(lot.AvilableQuantity <= 0 ? "zero" : "")">@lot.AvilableQuantity</span></td>
                                <td><span class="iv-sub fw-bold"><i class="bi bi-geo-alt"></i> @(lot.ShortLocation ?? "—")</span></td>
                                <td><span class="iv-pill @(lot.SDS == true ? "ok" : "bad")"><i class="bi @(lot.SDS == true ? "bi-shield-fill-check" : "bi-shield-x")"></i>@(lot.SDS == true ? "Valid" : "Invalid")</span></td>
                                <td data-order="@lot.ReceivedDate?.ToString("yyyyMMdd")"><span class="iv-sub fw-bold">@lot.ReceivedDate?.ToString("dd MMM yyyy")</span></td>
                                <td><span class="iv-temp @(cold ? "cold" : "room")"><i class="bi bi-thermometer-half"></i>@lot.Item?.StorageUnitType?.Name</span></td>
                                <td>
                                    <div class="iv-actions-cell">
                                        @if (Model.CanViewDetails)
                                        {
                                            <a class="iv-icon-btn" data-tip="Details" asp-controller="Lots" asp-action="SelectedLot" asp-route-Id="@lot.Id"><i class="bi bi-eye-fill"></i></a>
                                        }
                                        @if (Model.CanPrintBarcode)
                                        {
                                            <a class="iv-icon-btn" data-tip="Print label" target="_blank" asp-controller="Lots" asp-action="PrintLot" asp-route-id="@lot.Id"><i class="bi bi-printer-fill"></i></a>
                                        }
                                        @if (Model.CanEditLot)
                                        {
                                            <span class="iv-icon-btn locked" data-tip="Lots are immutable"><i class="bi bi-pencil-square"></i></span>
                                        }
                                        @if (Model.CanDeleteLot)
                                        {
                                            <a class="iv-icon-btn danger" data-tip="Delete" onclick="DeleteLot('@lot.Id')"><i class="bi bi-trash3-fill"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<partial name="_SaveLot" />
<partial name="_ExpiryLots" />
<partial name="_ListItems" />
<partial name="_ListItemsDis" />

@section Scripts {
    <script src="~/js/Users.js"></script>
    <script src="~/js/inventory.js" asp-append-version="true"></script>

    @if (!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
    {
        var ok = Context.Session.GetString(Helper.MsgType) == Helper.Success;
        <script>
            Swal.fire({
                title: '@Context.Session.GetString(Helper.Title)',
                text: '@Html.Raw(Context.Session.GetString(Helper.Msg))',
                icon: '@(ok ? "success" : "error")',
                confirmButtonText: 'Ok',
                confirmButtonColor: '#032b42'
            });
        </script>
        Context.Session.SetString(Helper.MsgType, "");
    }

    <script>
        let lbTitleEdit = '@Html.Raw("Edit Lot")';
        let lbEdit = '@Html.Raw("Save Changes")';
        let lbAddNewRole = '@Html.Raw("Add New Lot")';
        let lbbtnSave = '@Html.Raw("Save Data")';

        let lbTitleMsgDelete = '@Html.Raw("Delete Lot")';
        let lbTextMsgDelete = '@Html.Raw("Are you sure? This deletes the lot and everything related to it, including requests and records.")';
        let lbconfirmButtonText = '@Html.Raw("Yes, remove")';
        let lbcancelButtonText = '@Html.Raw("Cancel")';

        let lbTitleDeletedOk = '@Html.Raw("Lot deleted")';
        let lbMsgDeletedOkRole = '@Html.Raw("The lot has been deleted successfully!")';
        let lbSuccess = '@Html.Raw(Helper.Success)';

        IV.scanPicker({ modal: 'ListItemsModalCreate', input: '#itemsSearchInputCreate', message: '#scanMessageCreate' });
        IV.scanPicker({ modal: 'ListItemsModalExchange', input: '#itemsSearchInputExchange', message: '#scanMessageExchange' });
    </script>
}
