@model LotViewModel
@{
    var canExchange = AuthorizationService.AuthorizeAsync(User, Permissions.Lots.Exchange_Lots).Result.Succeeded;
    var inStock = Model.ItemsList.Where(x => x.AvilableQuantity > 0).ToList();
    int n = 0;
}

<div class="modal fade iv-modal" id="ListItemsModalExchange" tabindex="-1" aria-hidden="true" dir="ltr">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-cart-dash-fill"></i> Exchange Lot — choose item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="actionModeExchange" value="exchange" />
                <div class="iv-scan">
                    <i class="bi bi-upc-scan"></i>
                    <input type="text" id="itemsSearchInputExchange" class="form-control" placeholder="Scan item barcode or type a name…" autocomplete="off" />
                    <div id="scanMessageExchange" class="iv-scan-msg d-none"><i class="bi bi-exclamation-octagon-fill"></i> No in-stock item matches this barcode</div>
                </div>

                @if (!inStock.Any())
                {
                    <div class="iv-empty"><i class="bi bi-inbox"></i><h5>Nothing to exchange</h5><p>No item currently has available quantity.</p></div>
                }
                else
                {
                    <div class="iv-pick-grid">
                        @foreach (var item in inStock)
                        {
                            var cold = item.StorageUnitType?.TemperatureValue < 0;
                            var low = item.AvilableQuantity <= item.Limit;
                            if (canExchange)
                            {
                                <a class="iv-pick item-card" data-barcode="@item.Code" data-name="@item.Name"
                                   asp-controller="Items" asp-action="ExchangeLot" asp-route-id="@item.Id"
                                   style="animation-delay:@(Math.Min(n++, 14) * 30)ms">
                                    <div class="iv-pick-top">
                                        <div class="iv-pick-name">@item.Name</div>
                                        <span class="iv-code"><img src="@item.BarcodeImage" alt="" loading="lazy" /><span>@item.Code</span></span>
                                    </div>
                                    <div class="iv-pick-meta">
                                        <span class="iv-temp @(cold ? "cold" : "room")"><i class="bi bi-thermometer-half"></i>@item.StorageUnitType?.Name</span>
                                    </div>
                                    <div class="iv-pick-meta">
                                        <span class="iv-pill teal">@item.Category?.Name</span>
                                        <span class="iv-pill @(low ? "bad" : "ok")">Available @item.AvilableQuantity</span>
                                    </div>
                                    <div class="iv-pick-go"><span class="action-btn" data-action="exchange">Exchange</span><i class="bi bi-arrow-right-circle-fill fs-5"></i></div>
                                </a>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
