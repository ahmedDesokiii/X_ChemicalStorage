@model X_ChemicalStorage.Models.ViewModels.RoomsViewModel
@{
    ViewData["Title"] = "Generate Storage Structure";
}
<link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />
<style>
    .gw-unit { position: relative; background: #fff; border: 1.5px solid var(--iv-line); border-radius: 18px; padding: 18px; margin-bottom: 14px; transition: border-color .25s, box-shadow .25s; animation: gwIn .45s var(--iv-ease) both; }
    .gw-unit:hover { border-color: rgba(63,154,174,.55); }
    .gw-unit.hold { border-color: #14595b; background: linear-gradient(180deg, #f2fbfa, #fff 40%); }
    .gw-unit.removing { animation: gwOut .3s var(--iv-ease) forwards; }
    @@keyframes gwIn { from { opacity: 0; transform: translateY(18px) scale(.98); } }
    @@keyframes gwOut { to { opacity: 0; transform: translateX(40px) scale(.95); height: 0; margin: 0; padding: 0; } }
    .gw-unit-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .gw-num { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; background: var(--iv-navy); color: var(--iv-gold); }
    .gw-unit.hold .gw-num { background: #0f3d3e; color: #f4b740; }
    .gw-unit-head b { color: var(--iv-navy); }
    .gw-rm { margin-left: auto; }
    .gw-zone { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .gw-zone input { position: absolute; opacity: 0; pointer-events: none; }
    .gw-zone label { text-align: center; padding: 10px; border-radius: 12px; border: 1.5px solid var(--iv-line); font-weight: 800; font-size: .82rem; color: var(--iv-muted); cursor: pointer; transition: .2s; margin: 0 !important; text-transform: none !important; letter-spacing: 0 !important; }
    .gw-zone input:checked + label.inv { background: var(--iv-navy); border-color: var(--iv-navy); color: #fff; }
    .gw-zone input:checked + label.hold { background: #0f3d3e; border-color: #0f3d3e; color: #f4b740; }
    .gw-haz { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 12px; border: 1.5px solid #f7c1c3; background: repeating-linear-gradient(-45deg, #fff 0 8px, #fff6f6 8px 16px); cursor: pointer; font-weight: 800; color: var(--iv-bad); font-size: .82rem; margin: 0 !important; text-transform: none !important; letter-spacing: 0 !important; }
    .gw-haz input { width: 18px; height: 18px; accent-color: var(--iv-bad); }
    .gw-presets { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
    .gw-presets button { border: 1.5px solid var(--iv-line); background: #fff; border-radius: 8px; padding: 2px 10px; font-size: .74rem; font-weight: 800; color: var(--iv-navy); transition: .2s; }
    .gw-presets button:hover, .gw-presets button.on { border-color: var(--iv-gold); background: var(--iv-gold-soft); }
    .gw-add { width: 100%; border: 2px dashed var(--iv-line); background: #fff; border-radius: 16px; padding: 14px; font-weight: 800; color: var(--iv-muted); transition: .25s; }
    .gw-add:hover { border-color: var(--iv-gold); color: var(--iv-gold-dark); background: var(--iv-gold-soft); transform: translateY(-2px); }
    .gw-stepper { display: flex; border: 1.5px solid var(--iv-line); border-radius: 12px; overflow: hidden; background: #fff; }
    .gw-stepper input { border: 0 !important; text-align: center; font-weight: 800; box-shadow: none !important; min-width: 0; padding: 8px 4px !important; }
    .gw-stepper button { border: 0; width: 34px; background: #f0f4f8; color: var(--iv-navy); font-weight: 800; transition: .2s; }
    .gw-stepper button:hover { background: var(--iv-gold-soft); }

    /* blueprint */
    .gw-side { position: sticky; top: 20px; }
    .gw-blueprint { border-radius: 22px; padding: 18px; color: #cfe3ee; min-height: 260px; position: relative; overflow: hidden;
        background: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px) 0 0/20px 20px, linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px) 0 0/20px 20px, linear-gradient(135deg, #032b42, #064663); box-shadow: var(--iv-shadow-lg); }
    .gw-blueprint h6 { color: #fff; font-weight: 800; display: flex; gap: 8px; align-items: center; margin-bottom: 14px; }
    .gw-blueprint h6 i { color: var(--iv-gold); }
    .gw-floor { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; min-height: 150px; }
    .gw-cab { background: rgba(255,255,255,.06); border: 1.5px solid rgba(197,165,71,.55); border-radius: 8px 8px 4px 4px; padding: 5px; display: flex; flex-direction: column; gap: 3px; width: 64px; position: relative; animation: gwCab .5s var(--iv-ease) both; transform-origin: bottom; }
    .gw-cab.hold { border-color: #f4b740; background: rgba(244,183,64,.08); }
    .gw-cab.haz::before { content: '☢'; position: absolute; top: -10px; right: -8px; font-size: .8rem; color: #ff8a92; }
    .gw-cab small { font-size: .55rem; text-align: center; opacity: .7; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    @@keyframes gwCab { from { opacity: 0; transform: scaleY(.2); } }
    .gw-shelf { display: flex; gap: 2px; flex-wrap: wrap; border-bottom: 1.5px solid rgba(255,255,255,.25); padding-bottom: 2px; min-height: 9px; }
    .gw-bx { width: 7px; height: 7px; border-radius: 2px; background: var(--iv-teal); animation: ivPop .35s var(--iv-ease) both; }
    .gw-cab.hold .gw-bx { background: #f4b740; }
    .gw-more { align-self: center; font-weight: 800; color: var(--iv-gold); }
    .gw-sum { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 14px; }
    .gw-sum div { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); border-radius: 14px; padding: 10px 12px; }
    .gw-sum b { display: block; color: #fff; font-size: 1.35rem; font-weight: 800; font-variant-numeric: tabular-nums; }
    .gw-sum small { font-size: .62rem; letter-spacing: 1.2px; text-transform: uppercase; font-weight: 800; opacity: .7; }
    .gw-sum .cap { grid-column: 1 / -1; border-color: rgba(197,165,71,.5); }
    .gw-sum .cap b { color: var(--iv-gold); font-size: 1.7rem; }
    .gw-breakdown { margin-top: 12px; display: grid; gap: 6px; font-size: .8rem; }
    .gw-breakdown div { display: flex; justify-content: space-between; gap: 8px; padding: 6px 10px; border-radius: 10px; background: rgba(255,255,255,.05); }
    .gw-breakdown b { color: #fff; }

    /* build overlay */
    .gw-overlay { position: fixed; inset: 0; z-index: 3000; display: none; place-items: center; background: rgba(3,43,66,.88); backdrop-filter: blur(6px); }
    .gw-overlay.show { display: grid; animation: ivRise .3s both; }
    .gw-build { width: min(420px, 90vw); color: #fff; text-align: center; }
    .gw-build .ico { width: 84px; height: 84px; margin: 0 auto 16px; border-radius: 24px; display: grid; place-items: center; font-size: 2.2rem; color: var(--iv-navy); background: var(--iv-gold); animation: gwSpin 1.6s var(--iv-ease) infinite; }
    @@keyframes gwSpin { 50% { transform: rotate(180deg) scale(.9); border-radius: 50%; } }
    .gw-steps { text-align: left; display: grid; gap: 8px; margin-top: 14px; }
    .gw-steps div { display: flex; gap: 10px; align-items: center; opacity: .35; transition: opacity .3s; font-weight: 700; }
    .gw-steps div.on { opacity: 1; } .gw-steps div.on i { color: var(--iv-gold); }
</style>

<!-- ═════════ HERO ═════════ -->
<div class="iv-hero" dir="ltr">
    <div class="iv-hero-orb"></div>
    <div class="container-fluid">
        <nav class="iv-crumbs">
            <a asp-controller="Rooms" asp-action="Index"><i class="bi bi-building"></i> Storage Locations</a>
            <i class="bi bi-chevron-right"></i><span>Auto-Generate</span>
        </nav>
        <div class="iv-hero-id">
            <div class="iv-hero-icon"><i class="bi bi-magic"></i></div>
            <div>
                <h1 class="iv-hero-title">Generate Storage Structure</h1>
                <p class="iv-hero-sub">Describe the room once — units, shelves, boxes and slots are created in a single transaction.</p>
            </div>
        </div>
    </div>
</div>

<form method="post" asp-controller="Rooms" asp-action="GenerateWizard" id="wizardForm" class="iv-form" dir="ltr">
    <div class="container-fluid pb-4">
        <div class="row g-4">
            <div class="col-xl-7">
                <div class="iv-panel">
                    <div class="iv-panel-head gold">
                        <div class="ph-icon"><i class="bi bi-door-open-fill"></i></div>
                        <div><h5>Room</h5><small>Display name of the new room</small></div>
                    </div>
                    <div class="iv-panel-body">
                        <div class="iv-input-icon">
                            <i class="bi bi-tag-fill"></i>
                            <input type="text" name="RoomName" id="roomName" required class="form-control form-control-lg" placeholder="e.g. Cold Room 1" autofocus />
                        </div>
                    </div>
                </div>

                <div class="iv-panel">
                    <div class="iv-panel-head">
                        <div class="ph-icon"><i class="bi bi-box-seam"></i></div>
                        <div><h5>Storage units</h5><small>One block per unit type — choose Lots inventory or Temporary holding</small></div>
                        <div class="ph-end"><span class="iv-pill muted" id="unitCountBadge">0 types</span></div>
                    </div>
                    <div class="iv-panel-body">
                        <div id="unitsContainer"></div>
                        <button type="button" class="gw-add" id="addUnitBtn"><i class="bi bi-plus-circle-fill"></i> Add unit type</button>
                    </div>
                </div>
            </div>

            <div class="col-xl-5">
                <div class="gw-side">
                    <div class="gw-blueprint">
                        <h6><i class="bi bi-rulers"></i> Live blueprint</h6>
                        <div class="gw-floor" id="floor"></div>
                        <div class="gw-sum">
                            <div><b id="sumUnits">0</b><small>Units</small></div>
                            <div><b id="sumShelves">0</b><small>Shelves</small></div>
                            <div><b id="sumBoxes">0</b><small>Boxes</small></div>
                            <div><b id="sumHold">0</b><small>Holding units</small></div>
                            <div class="cap"><b id="sumCapacity">0</b><small>Total slots</small></div>
                        </div>
                        <div class="gw-breakdown" id="breakdownList"></div>
                    </div>
                    <button type="submit" class="iv-btn iv-btn-gold w-100 mt-3" id="generateBtn" style="padding:14px;font-size:1rem" disabled>
                        <i class="bi bi-lightning-charge-fill"></i> Generate structure
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="gw-overlay" id="overlay">
    <div class="gw-build">
        <div class="ico"><i class="bi bi-building-gear"></i></div>
        <h4 class="fw-bold">Building <span id="ovRoom"></span></h4>
        <div class="gw-steps" id="ovSteps">
            <div><i class="bi bi-check-circle-fill"></i> Creating room</div>
            <div><i class="bi bi-check-circle-fill"></i> Creating <span id="ovUnits"></span> units</div>
            <div><i class="bi bi-check-circle-fill"></i> Mounting <span id="ovShelves"></span> shelves</div>
            <div><i class="bi bi-check-circle-fill"></i> Placing <span id="ovBoxes"></span> boxes</div>
            <div><i class="bi bi-check-circle-fill"></i> Mapping <span id="ovSlots"></span> slots</div>
        </div>
    </div>
</div>

<template id="unitRowTemplate">
    <div class="gw-unit" data-index="__I__">
        <div class="gw-unit-head">
            <div class="gw-num">__N__</div>
            <b class="gw-title">Unit type</b>
            <button type="button" class="iv-icon-btn danger gw-rm" data-tip="Remove"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="row g-3">
            <div class="col-md-6 iv-field mb-0">
                <label>Zone</label>
                <div class="gw-zone">
                    <input type="radio" name="Units[__I__].Zone" value="Inventory" id="zi___I__" checked /><label for="zi___I__" class="inv"><i class="bi bi-boxes"></i> Lots</label>
                    <input type="radio" name="Units[__I__].Zone" value="TemporaryHolding" id="zh___I__" /><label for="zh___I__" class="hold"><i class="bi bi-hourglass-split"></i> Temp holding</label>
                </div>
            </div>
            <div class="col-md-6 iv-field mb-0">
                <label>Unit type</label>
                <select name="Units[__I__].StorageUnitTypeId" class="form-select gw-type" required>
                    <option value="" selected disabled>Choose type…</option>
                    @foreach (var t in Model.ListStorageUnitTypes) { <option value="@t.Value">@t.Text</option> }
                </select>
            </div>
            <div class="col-6 col-md-3 iv-field mb-0"><label>Units</label><div class="gw-stepper"><button type="button" data-d="-1">−</button><input type="number" min="1" value="1" name="Units[__I__].UnitsCount" class="form-control gw-units" required /><button type="button" data-d="1">+</button></div></div>
            <div class="col-6 col-md-3 iv-field mb-0"><label>Shelves / unit</label><div class="gw-stepper"><button type="button" data-d="-1">−</button><input type="number" min="1" value="4" name="Units[__I__].ShelvesPerUnit" class="form-control gw-shelves" required /><button type="button" data-d="1">+</button></div></div>
            <div class="col-6 col-md-3 iv-field mb-0"><label>Boxes / shelf</label><div class="gw-stepper"><button type="button" data-d="-1">−</button><input type="number" min="1" value="4" name="Units[__I__].BoxesPerShelf" class="form-control gw-boxes" required /><button type="button" data-d="1">+</button></div></div>
            <div class="col-6 col-md-3 iv-field mb-0 d-flex align-items-end">
                <label class="gw-haz w-100">
                    <input type="checkbox" value="true" name="Units[__I__].IsHazardous" class="gw-hazcb" />
                    <input type="hidden" name="Units[__I__].IsHazardous" value="false" />
                    <i class="bi bi-radioactive"></i> Hazardous
                </label>
            </div>
            <div class="col-12 iv-field mb-0">
                <label>Box grid (rows × columns)</label>
                <div class="d-flex gap-2 align-items-center">
                    <input type="number" min="1" value="9" name="Units[__I__].RowsCount" class="form-control gw-rows" style="max-width:100px" required />
                    <span class="fw-bold text-muted">×</span>
                    <input type="number" min="1" value="9" name="Units[__I__].ColumnsCount" class="form-control gw-cols" style="max-width:100px" required />
                    <div class="gw-presets ms-2"><button type="button" data-g="9x9" class="on">9×9</button><button type="button" data-g="10x10">10×10</button><button type="button" data-g="5x5">5×5</button><button type="button" data-g="8x12">8×12</button></div>
                </div>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <script src="~/js/inventory.js" asp-append-version="true"></script>
    <script>
        (() => {
            const $ = (s, r = document) => r.querySelector(s);
            const $$ = (s, r = document) => [...r.querySelectorAll(s)];
            const box = $('#unitsContainer'), tpl = $('#unitRowTemplate').innerHTML, btn = $('#generateBtn');
            const n = el => parseInt(el.value) || 0;

            function addRow() {
                const i = $$('.gw-unit', box).length;
                const w = document.createElement('div');
                w.innerHTML = tpl.replaceAll('__I__', i).replaceAll('__N__', i + 1);
                const row = w.firstElementChild;
                box.appendChild(row);
                bind(row);
                refresh();
            }

            function bind(row) {
                row.addEventListener('input', refresh);
                row.addEventListener('change', refresh);
                $$('.gw-stepper button', row).forEach(b => b.addEventListener('click', () => {
                    const inp = $('input', b.parentElement); inp.value = Math.max(1, n(inp) + +b.dataset.d); refresh();
                }));
                $$('.gw-presets button', row).forEach(b => b.addEventListener('click', () => {
                    const [r, c] = b.dataset.g.split('x'); $('.gw-rows', row).value = r; $('.gw-cols', row).value = c;
                    $$('.gw-presets button', row).forEach(x => x.classList.toggle('on', x === b)); refresh();
                }));
                const cb = $('.gw-hazcb', row); cb.addEventListener('change', () => cb.nextElementSibling.disabled = cb.checked);
                $('.gw-rm', row).addEventListener('click', () => { row.classList.add('removing'); setTimeout(() => { row.remove(); reindex(); refresh(); }, 280); });
            }

            function reindex() {
                $$('.gw-unit', box).forEach((row, i) => {
                    row.dataset.index = i; $('.gw-num', row).textContent = i + 1;
                    $$('[name]', row).forEach(el => el.name = el.name.replace(/Units\[\d+\]/, `Units[${i}]`));
                    $$('[id]', row).forEach(el => el.id = el.id.replace(/_\d+$/, '_' + i));
                    $$('label[for]', row).forEach(el => el.htmlFor = el.htmlFor.replace(/_\d+$/, '_' + i));
                });
            }

            function refresh() {
                let U = 0, S = 0, B = 0, C = 0, H = 0;
                const floor = $('#floor'), bd = [];
                floor.innerHTML = '';
                $$('.gw-unit', box).forEach(row => {
                    const units = n($('.gw-units', row)), sh = n($('.gw-shelves', row)), bx = n($('.gw-boxes', row));
                    const cap = units * sh * bx * n($('.gw-rows', row)) * n($('.gw-cols', row));
                    const hold = $('input[value="TemporaryHolding"]', row).checked, haz = $('.gw-hazcb', row).checked;
                    const type = $('.gw-type', row); const tName = type.value ? type.selectedOptions[0].text : 'Unit';
                    row.classList.toggle('hold', hold);
                    $('.gw-title', row).textContent = (hold ? 'Holding · ' : '') + tName;
                    U += units; S += units * sh; B += units * sh * bx; C += cap; if (hold) H += units;
                    if (units) bd.push(`<div><span>${haz ? '☢ ' : ''}${hold ? '⏳ ' : ''}${tName} × ${units}</span><b>${cap.toLocaleString()} slots</b></div>`);

                    // draw cabinets (capped so the blueprint stays readable)
                    for (let u = 0; u < Math.min(units, 6); u++) {
                        const cab = document.createElement('div');
                        cab.className = 'gw-cab' + (hold ? ' hold' : '') + (haz ? ' haz' : '');
                        cab.style.animationDelay = (u * 60) + 'ms';
                        for (let s = 0; s < Math.min(sh, 8); s++) {
                            const shelf = document.createElement('div'); shelf.className = 'gw-shelf';
                            for (let b = 0; b < Math.min(bx, 6); b++) {
                                const q = document.createElement('span'); q.className = 'gw-bx';
                                q.style.animationDelay = (u * 60 + s * 30 + b * 15) + 'ms'; shelf.appendChild(q);
                            }
                            cab.appendChild(shelf);
                        }
                        const lbl = document.createElement('small'); lbl.textContent = tName; cab.appendChild(lbl);
                        floor.appendChild(cab);
                    }
                    if (units > 6) floor.insertAdjacentHTML('beforeend', `<span class="gw-more">+${units - 6}</span>`);
                });
                if (!floor.children.length) floor.innerHTML = '<div class="w-100 text-center py-4" style="opacity:.6"><i class="bi bi-inbox fs-2 d-block"></i>Add a unit type to see the blueprint</div>';

                [['#sumUnits', U], ['#sumShelves', S], ['#sumBoxes', B], ['#sumHold', H], ['#sumCapacity', C]].forEach(([s, v]) => $(s).textContent = v.toLocaleString());
                $('#breakdownList').innerHTML = bd.join('');
                $('#unitCountBadge').textContent = `${$$('.gw-unit', box).length} types`;
                btn.disabled = !($('#roomName').value.trim() && $$('.gw-unit', box).length && $$('.gw-type', box).every(t => t.value));
                Object.assign(window, { __gw: { U, S, B, C } });
            }

            $('#addUnitBtn').addEventListener('click', addRow);
            $('#roomName').addEventListener('input', refresh);

            $('#wizardForm').addEventListener('submit', e => {
                if (e.target.dataset.go) return;
                e.preventDefault();
                const g = window.__gw;
                $('#ovRoom').textContent = $('#roomName').value;
                $('#ovUnits').textContent = g.U; $('#ovShelves').textContent = g.S; $('#ovBoxes').textContent = g.B; $('#ovSlots').textContent = g.C.toLocaleString();
                $('#overlay').classList.add('show');
                const steps = $$('#ovSteps div');
                steps.forEach((s, i) => setTimeout(() => s.classList.add('on'), 250 + i * 280));
                setTimeout(() => { e.target.dataset.go = 1; e.target.submit(); }, 250 + steps.length * 280);
            });

            addRow();
        })();
    </script>
    @if (TempData["Error"] != null)
    {
        <script>Swal.fire({ icon: 'error', title: 'Not generated', text: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Error"]!.ToString()!))', confirmButtonColor: '#032b42' });</script>
    }
}
