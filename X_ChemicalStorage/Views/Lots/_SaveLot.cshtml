@model LotViewModel


<!-- Modal -->
<div class="modal fade " id="EditLotModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" dir="ltr">
    <div class="modal-dialog card card-success card-outline">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#758A93" dir="ltr">
                <span class="fs-4 fw-bold modal-title" id="title"></span>
                <a href="#" class="btn-close position-absolute  end-0 mx-3" data-bs-dismiss="modal" aria-label="Close"></a>
            </div>
            <form asp-action="Save" asp-controller="Lots" method="post">

                <div class="modal-body">
                    <input hidden class="form-control" asp-for="NewLot.Id" id="editLotId" value="0" />

                    <!---------------------------- Lot Data ----------------------------------->
                    <!-- Lot Barcode -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4" id="inputGroup-sizing-default ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Lot Barcode &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                        <div class="card col-md-8 py-1" style="border-top-right-radius : 20px ;">
                            <div class="card-body row p-0 mx-auto" style="border-top-right-radius : 20px ;">
                                <img src="~/lotbarcodes/184799d5.png" height="80" />
                            </div>
                        </div>
                    </div>

                    <!-- Lot Number -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4" id="inputGroup-sizing-default ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Lot Number &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                        <input id="editLotNum" asp-for="NewLot.LotNumber" readonly required class="form-control text-center fw-bold" autocomplete="on" aria-required="true" placeholder="Generate Lot Barcode ...!" type="text" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-right-radius : 20px ;">
                    </div>

                    <!-- Lot Quantity -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4" id="inputGroup-sizing-default ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Lot Quantity &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                        <input readonly id="editLotQty" asp-for="@Model.NewLot.TotalQuantity" class="form-control text-center " type="number" min="0" style="border-top-right-radius : 20px ;" autofocus>
                    </div>

                    <!-- Lot Expiry Date -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4" id="inputGroup-sizing-default ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Lot Expiry Date &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                        <input readonly type="text" id="editLotExpiryDate" asp-for="@Model.NewLot.ExpiryDate" class="form-control text-center " style="border-top-right-radius : 20px ;">
                    </div>

                    <!-- Lot Storage Location -->
                    <div class="card p-0 mt-2 shadow-sm" style="border-radius:16px; overflow:hidden;">
                        <div class="card-header py-2 bg-success-subtle d-flex align-items-center">
                            <i class="bi bi-geo-alt-fill link-success fs-4 pe-2"></i>
                            <span class="fw-bold link-success fs-5">Storage Location</span>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-2">
                                <div class="col-md-3 col-6">
                                    <label class="form-label small fw-bold text-muted">Room</label>
                                    <select id="editSelRoom" class="form-select">
                                        <option value="" selected disabled>Choose Room</option>
                                        @foreach (var r in Model.ListRooms)
                                        {
                                            <option value="@r.Value">@r.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 col-6">
                                    <label class="form-label small fw-bold text-muted">Storage Unit</label>
                                    <select id="editSelUnit" class="form-select" disabled>
                                        <option value="" selected disabled>Choose Unit</option>
                                    </select>
                                </div>
                                <div class="col-md-3 col-6">
                                    <label class="form-label small fw-bold text-muted">Shelf</label>
                                    <select id="editSelShelf" class="form-select" disabled>
                                        <option value="" selected disabled>Choose Shelf</option>
                                    </select>
                                </div>
                                <div class="col-md-3 col-6">
                                    <label class="form-label small fw-bold text-muted">Box</label>
                                    <select id="editSelBox" class="form-select" disabled>
                                        <option value="" selected disabled>Choose Box</option>
                                    </select>
                                </div>
                            </div>

                            <div id="editGridWrapper" class="mt-4 text-center" style="display:none;">
                                <div class="d-flex justify-content-center gap-4 mb-3 small fw-bold">
                                    <span><span class="legend-box legend-free"></span> Available</span>
                                    <span><span class="legend-box legend-occupied"></span> Occupied</span>
                                    <span><span class="legend-box legend-selected"></span> Selected</span>
                                </div>
                                <div class="table-responsive d-inline-block mx-auto">
                                    <table id="editBoxGridTable" class="table table-bordered mb-0" style="width:auto;"></table>
                                </div>
                                <div class="mt-2 fw-bold text-primary" id="editSelectedSlotLabel">No slot selected yet</div>
                            </div>

                            <input type="hidden" asp-for="NewLot.Id" id="editCurrentLotId" />
                            <input type="hidden" asp-for="NewLot.BoxId" id="editHiddenBoxId" />
                            <input type="hidden" asp-for="NewLot.RowIndex" id="editHiddenRowIndex" />
                            <input type="hidden" asp-for="NewLot.ColumnIndex" id="editHiddenColumnIndex" />

                            <!-- بيانات المكان الحالي - هنستخدمها بس عشان نعمل Pre-selection وقت فتح المودال -->
                            <input type="hidden" id="editCurrentRoomId" value="@Model.NewLot?.Box?.Shelf?.StorageUnit?.RoomId" />
                            <input type="hidden" id="editCurrentUnitId" value="@Model.NewLot?.Box?.Shelf?.StorageUnitId" />
                            <input type="hidden" id="editCurrentShelfId" value="@Model.NewLot?.Box?.ShelfId" />
                            <input type="hidden" id="editCurrentBoxId" value="@Model.NewLot?.BoxId" />

                            <span asp-validation-for="@Model.NewLot.BoxId" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Lot Manufacture Date -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4" id="inputGroup-sizing-default "> &nbsp;&nbsp;Manufacture Date </span>
                        <input readonly type="text" id="editLotManf" asp-for="@Model.NewLot.ManufactureDate" class="form-control text-center " style="border-top-right-radius : 20px ;">
                    </div>
                    <!-- Lot Receiving Date -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4" id="inputGroup-sizing-default ">&nbsp;&nbsp; Received Date </span>
                        <input readonly type="text" id="editLotReci" asp-for="@Model.NewLot.ReceivedDate" class="form-control text-center bg-light" style="border-top-right-radius : 20px ;">
                    </div>

                    <!-- Lot SDS -->
                    <div class="input-group mt-3 row mx-auto">
                        <span class="input-group-text bg-info-subtle fw-bold rounded-end-3 col-md-4" id="inputGroup-sizing-default ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Lot SDS &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                        <div class="card col-md-8 py-0" style="border-top-right-radius : 20px ;">
                            <div class="card-body row p-0 mx-auto" style="border-top-right-radius : 20px ;">
                                <div class="col-md-4 text-center my-0">
                                    <label for="editSdsYes" class="radio-card" onclick="document.getElementById('editLotSDS').value = 'True'; ">
                                        <input type="radio" hidden name="edit-radio-card" id="editSdsYes" />
                                        <div class="card-content-wrapper rounded-3 py-2 px-4">
                                            <span class="bi bi-shield-fill-check link-success fs-3"></span>
                                            <br class="m-0 p-0">
                                            <span class="link-dark mb-0">Valid</span>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-md-3 text-center"></div>
                                <div class=" col-md-4 text-center my-0">
                                    <label for="editSdsNo" class="radio-card" onclick="document.getElementById('editLotSDS').value = 'False'; ">
                                        <input type="radio" hidden name="edit-radio-card" id="editSdsNo" />
                                        <div class="card-content-wrapper rounded-3 py-2 px-3">
                                            <span class="bi bi-shield-x link-danger fs-3"></span>
                                            <br class="m-0 p-0">
                                            <span class="link-dark mb-0">Invalid</span>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <input id="editLotSDS" required hidden asp-for="@Model.NewLot.SDS" class="form-control text-center" autocomplete="on" aria-required="true" placeholder="Enter Item SDS ..." type="text" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-right-radius : 20px ;">
                    </div>
                    <span asp-validation-for="@Model.NewLot.SDS" class="text-danger"></span>

                    <!-- /.card-body -->
                </div>
                <div class="modal-footer mx-auto justify-content-center my-2 py-3">
                    <input type="submit" class="btn btn-success" value="Save changes" id="editBtnSave" asp-action="Save" asp-controller="Lots" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancle</button>
                </div>
            </form>
        </div>

    </div>
</div>
</div>

<style>
    .cell-free {
        background: #d4edda;
        border: 1px solid #b7dfc0;
        width: 38px;
        height: 38px;
        cursor: pointer;
        text-align: center;
        vertical-align: middle;
        transition: .15s;
    }

        .cell-free:hover {
            background: #a9dcb5;
            transform: scale(1.05);
        }

    .cell-occupied {
        background: #f5c6cb;
        border: 1px solid #eab5ba;
        width: 38px;
        height: 38px;
        text-align: center;
        vertical-align: middle;
        cursor: not-allowed;
    }

    .cell-selected {
        background: #0d6efd !important;
        color: #fff;
    }

    .legend-box {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 3px;
        margin-left: 4px;
        vertical-align: middle;
    }

    .legend-free {
        background: #d4edda;
        border: 1px solid #b7dfc0;
    }

    .legend-occupied {
        background: #f5c6cb;
        border: 1px solid #eab5ba;
    }

    .legend-selected {
        background: #0d6efd;
    }
</style>