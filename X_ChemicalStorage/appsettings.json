{

  //"ConnectionStrings": {
    // الإنتاج (جهاز المعمل): SQL Server Express. للتطوير بيتغير في appsettings.Development.json
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=X_ChemicalStorage_DB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },

  // ⚠ ممنوع تحط أي باسورد أو Token في الملف ده (الريبو public).
  // الأسرار بتتحط في appsettings.Local.json (متجاهَل من git) أو Environment Variables.

  "Hosting": {
    "Urls": "http://0.0.0.0:5000",
    "UseHttpsRedirection": false
  },

  "Startup": {
    "AutoMigrate": true,
    "SeedDemoUsers": false
  },

  "AdminSeed": {
    "UserName": "admin",
    "Email": "admin@lab.local",
    "Password": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "IoT": { "TestConsole": false },
  "Mqtt": {
    "Host": "127.0.0.1",
    "Port": 1883,
    "StoreIntervalSeconds": 60,
    "ClientId": "BioBank-IoT-Service",
    "Username": "",
    "Password": "",
    "Topic": "freezer/+/telemetry",
    "UseTls": false
  },

  // MaxReminders = 0 يعني بدون حد (مش مُستحسن: تكلفة/حد الـ SMS). 20 تذكير x 15 دقيقة = 5 ساعات.

  "Notifications": {
    "MaxAttempts": 20,
    "Reminder": {
      "Enabled": true,
      "IntervalMinutes": 15,
      "MaxReminders": 20
    },
    "Telegram": {
      "Enabled": true,
      "BotToken": ""
    },
    "NotifyOnCleared": true,
    "TimeZoneId": "Egypt Standard Time",
    "Sms": {
      "Enabled": false,
      "Url": "https://YOUR-SMS-PROVIDER/api/send",
      "Method": "POST",
      "BodyFormat": "json",
      "BodyTemplate": "{\"to\":\"{to}\",\"message\":\"{message}\"}",
      "Headers": { "Authorization": "Bearer YOUR_TOKEN" },
      "SuccessContains": ""
    },
    "Email": {
      "Enabled": false,
      "Host": "smtp.example.com",
      "Port": 587,
      "EnableSsl": true,
      "User": "",
      "Password": "",
      "From": "alerts@example.com"
    }

  },
  "Monitoring": { "HeartbeatIntervalMinutes": 5 },


  "Backup": {
    "Enabled": true,
    "Directory": "D:\\BioBank_Backups",
    "SecondaryDirectory": "",
    "DailyTime": "02:00",
    "KeepDays": 30,
    "KeepMinimumFiles": 7,
    "IncludeAttachments": true
  },
  "AllowedHosts": "*"
}
